-- Headsit button handler
-- Shared stop attachment
local function StopAttachment()
    AttachmentMode = nil
    AttachmentLoop = false
    if AttachmentVelocity then
        AttachmentVelocity:Destroy()
        AttachmentVelocity = nil
    end
    if Humanoid then
        Humanoid.Sit = false
        Humanoid.PlatformStand = false
        pcall(function() Humanoid:ChangeState(Enum.HumanoidStateType.Freefall) end)
        Humanoid.WalkSpeed = OriginalWalkSpeed or NormalSpeed
    end
    -- reset all attach button colors
    for _, b in ipairs({HeadsitButton, BackpackButton, StandButton, DoggyButton, DragButton}) do
        b.BackgroundColor3 = Color3.fromRGB(32, 36, 55)
    end
end

local function StartAttachment(mode, button, offsetFunc)
    if not SelectedPlayer or not SelectedPlayer.Character or not RootPart then return end
    if AttachmentMode == mode then
        StopAttachment()
        return
    end
    StopAttachment()
    AttachmentMode = mode
    button.BackgroundColor3 = Color3.fromRGB(150, 60, 220)
    OriginalWalkSpeed = Humanoid.WalkSpeed
    Humanoid.WalkSpeed = 0
    if not AttachmentVelocity then
        AttachmentVelocity = Instance.new("BodyAngularVelocity")
        AttachmentVelocity.Name = "AttachmentVelocity"
        AttachmentVelocity.MaxTorque = Vector3.new(math.huge, math.huge, math.huge)
        AttachmentVelocity.AngularVelocity = Vector3.new(0, 0, 0)
        AttachmentVelocity.Parent = RootPart
    end
    AttachmentLoop = true
    task.spawn(function()
        while AttachmentLoop and SelectedPlayer and SelectedPlayer.Character and AttachmentMode == mode do
            pcall(function()
                local cf = offsetFunc(SelectedPlayer.Character)
                if cf then
                    RootPart.CFrame = cf
                    RootPart.Velocity = Vector3.new(0, 0, 0)
                end
            end)
            task.wait()
        end
    end)
end

HeadsitButton.MouseButton1Click:Connect(function()
    StartAttachment("headsit", HeadsitButton, function(char)
        local head = char:FindFirstChild("Head") or char:FindFirstChild("HumanoidRootPart")
        if head then
            Humanoid.Sit = true
            return head.CFrame * CFrame.new(0, 2, 0)
        end
    end)
end)

BackpackButton.MouseButton1Click:Connect(function()
    StartAttachment("backpack", BackpackButton, function(char)
        local root = char:FindFirstChild("HumanoidRootPart")
        if root then
            Humanoid.Sit = true
            return root.CFrame * CFrame.new(0, 0, 1.2) * CFrame.Angles(0, -3, 0)
        end
    end)
end)

StandButton.MouseButton1Click:Connect(function()
    StartAttachment("stand", StandButton, function(char)
        local root = char:FindFirstChild("HumanoidRootPart")
        if root then
            return root.CFrame * CFrame.new(-3, 1, 0)
        end
    end)
end)

DoggyButton.MouseButton1Click:Connect(function()
    StartAttachment("doggy", DoggyButton, function(char)
        local part = char:FindFirstChild("LowerTorso") or char:FindFirstChild("Torso") or char:FindFirstChild("HumanoidRootPart")
        if part then
            return part.CFrame * CFrame.new(0, 0.23, 0)
        end
    end)
end)

DragButton.MouseButton1Click:Connect(function()
    StartAttachment("drag", DragButton, function(char)
        local hand = char:FindFirstChild("RightHand") or char:FindFirstChild("Right Arm") or char:FindFirstChild("HumanoidRootPart")
        if hand then
            return hand.CFrame * CFrame.new(0, -2.5, 1) * CFrame.Angles(-2, -3, 0)
        end
    end)
end)

TeleportButton.MouseButton1Click:Connect(function()
    if SelectedPlayer and SelectedPlayer.Character and RootPart then
        local targetRoot = SelectedPlayer.Character:FindFirstChild("HumanoidRootPart")
        if targetRoot then
            -- Safe-ish TP: lock velocity briefly
            task.spawn(function()
                for i = 1, 20 do
                    RootPart.Velocity = Vector3.new(0, 0, 0)
                    RootPart.CFrame = targetRoot.CFrame * CFrame.new(0, 2, 0)
                    task.wait()
                end
                -- Keep air walk height if active
                if AirWalk and AirWalkPart then
                    AirWalkTargetY = RootPart.Position.Y
                    AirWalkPart.Position = Vector3.new(RootPart.Position.X, AirWalkTargetY - 3.5, RootPart.Position.Z)
                end
            end)
        end
    end
end)

-- View button handler
ViewButton.MouseButton1Click:Connect(function()
    if SpectateActive then
        SpectateActive = false
        ViewButton.BackgroundColor3 = Color3.fromRGB(32, 36, 55)
        ViewButton.Text = "VIEW"
        if OriginalCameraSubject then
            workspace.CurrentCamera.CameraSubject = OriginalCameraSubject
            OriginalCameraSubject = nil
        else
            workspace.CurrentCamera.CameraSubject = Player.Character.Humanoid
        end
    else
        if SelectedPlayer and SelectedPlayer.Character then
            local targetRoot = SelectedPlayer.Character:FindFirstChild("HumanoidRootPart")
            if targetRoot then
                SpectateActive = true
                ViewButton.BackgroundColor3 = Color3.fromRGB(150, 60, 220)
                ViewButton.Text = "VIEW: ON"
                OriginalCameraSubject = workspace.CurrentCamera.CameraSubject
                workspace.CurrentCamera.CameraSubject = targetRoot
            end
        end
    end
end)

-- Fling (basic BodyVelocity fling toward target)
FlingButton.MouseButton1Click:Connect(function()
    if not SelectedPlayer or not SelectedPlayer.Character or not RootPart then return end
    if FlingActive then
        FlingActive = false
        FlingButton.BackgroundColor3 = Color3.fromRGB(32, 36, 55)
        FlingButton.Text = "FLING"
        return
    end
    FlingActive = true
    FlingButton.BackgroundColor3 = Color3.fromRGB(150, 60, 220)
    FlingButton.Text = "FLING: ON"
    local savedPos = RootPart.CFrame
    task.spawn(function()
        local bv = Instance.new("BodyVelocity")
        bv.Name = "FlingBV"
        bv.MaxForce = Vector3.new(math.huge, math.huge, math.huge)
        bv.Velocity = Vector3.new(0, 0, 0)
        bv.Parent = RootPart
        while FlingActive and SelectedPlayer and SelectedPlayer.Character and RootPart do
            pcall(function()
                local tr = SelectedPlayer.Character:FindFirstChild("HumanoidRootPart")
                if tr then
                    RootPart.CFrame = tr.CFrame
                    bv.Velocity = Vector3.new(9999, 9999, 9999)
                end
            end)
            task.wait()
        end
        if bv then bv:Destroy() end
        if RootPart then
            RootPart.Velocity = Vector3.new(0, 0, 0)
            RootPart.CFrame = savedPos
        end
        FlingActive = false
        FlingButton.BackgroundColor3 = Color3.fromRGB(32, 36, 55)
        FlingButton.Text = "FLING"
    end)
end)

-- Player name input handler
PlayerNameInput.FocusLost:Connect(function(enterPressed)
    if enterPressed then
        local name = PlayerNameInput.Text
        if name ~= "" then
            -- Find closest matching player
            local closestPlayer = nil
            local closestMatch = 0
            
            for _, targetPlayer in pairs(Players:GetPlayers()) do
                local targetName = targetPlayer.Name:lower()
                local targetDisplay = targetPlayer.DisplayName:lower()
                local inputName = name:lower()
                
                -- Check for partial match
                if targetName:find(inputName, 1, true) or targetDisplay:find(inputName, 1, true) then
                    -- Calculate match length (longer match = closer)
                    local matchLength = math.max(
                        targetName:find(inputName, 1, true) and #inputName or 0,
                        targetDisplay:find(inputName, 1, true) and #inputName or 0
                    )
                    
                    if matchLength > closestMatch then
                        closestMatch = matchLength
                        closestPlayer = targetPlayer
                    end
                end
            end
            
            if closestPlayer then
                SelectedPlayer = closestPlayer
                SelectedLabel.Text = "Selected: " .. closestPlayer.Name
                PlayerNameInput.Text = closestPlayer.Name
                SelectedAvatar.Image = "rbxthumb://type=AvatarHeadShot&id=" .. closestPlayer.UserId .. "&w=48&h=48"
                UpdatePlayerList()
            else
                SelectedLabel.Text = "Selected: Not Found"
                SelectedAvatar.Image = ""
            end
        end
    end
end)

-- Initial population
UpdatePlayerList()

-- UI Dragging logic (drag from the AETHER title bar only)
local UIdragging = false
local dragStartMouse = Vector2.new()
local dragStartFrame = UDim2.new()
local MenuVisible = true

-- Toggle menu keybind (default B) + capture new key
UserInputService.InputBegan:Connect(function(input, gameProcessed)
    if input.UserInputType ~= Enum.UserInputType.Keyboard then return end

    if MenuKeyCapturing then
        MenuKeyCapturing = false
        if input.KeyCode ~= Enum.KeyCode.Unknown then
            MenuToggleKey = input.KeyCode
            if MenuKeyButton then
                MenuKeyButton.Text = "TOGGLE MENU: " .. input.KeyCode.Name
                MenuKeyButton.BackgroundColor3 = Color3.fromRGB(32, 36, 55)
            end
            print("[AETHER] Menu key set to:", input.KeyCode.Name)
        end
        return
    end

    if gameProcessed then return end
    if input.KeyCode == MenuToggleKey then
        MenuVisible = not MenuVisible
        MainFrame.Visible = MenuVisible
    end
end)

Title.InputBegan:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1
        or input.UserInputType == Enum.UserInputType.Touch then
        if SliderActive or BoostSliderActive or ColorWheelActive then return end
        UIdragging = true
        dragStartMouse = Vector2.new(input.Position.X, input.Position.Y)
        dragStartFrame = MainFrame.Position
    end
end)

UserInputService.InputEnded:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1
        or input.UserInputType == Enum.UserInputType.Touch then
        UIdragging = false
    end
end)

UserInputService.InputChanged:Connect(function(input)
    if not UIdragging then return end
    if input.UserInputType ~= Enum.UserInputType.MouseMovement
        and input.UserInputType ~= Enum.UserInputType.Touch then return end
    if SliderActive or BoostSliderActive or ColorWheelActive then return end
    local delta = Vector2.new(input.Position.X, input.Position.Y) - dragStartMouse
    MainFrame.Position = UDim2.new(
        dragStartFrame.X.Scale, dragStartFrame.X.Offset + delta.X,
        dragStartFrame.Y.Scale, dragStartFrame.Y.Offset + delta.Y
    )
end)

-- Fly controls
local function UpdateFly(deltaTime)
    if Flying and BodyVelocity and BodyGyro and Camera then
        local moveDirection = Vector3.new()
        local targetSpeed = FlySpeed
        
        -- Force humanoid state to Freefall to prevent walk/jump animations
        if Humanoid:GetState() ~= Enum.HumanoidStateType.Freefall then
            Humanoid:ChangeState(Enum.HumanoidStateType.Freefall)
        end
        
        -- Sprint with Shift
        if UserInputService:IsKeyDown(Enum.KeyCode.LeftShift) then
            targetSpeed = FlySpeed * FlySprintMultiplier
        end
        
        local camCF = Camera.CFrame
        local camLook = camCF.LookVector
        local camRight = camCF.RightVector
        
        -- Don't flatten - fly in full camera direction
        if UserInputService:IsKeyDown(Enum.KeyCode.W) then
            moveDirection = moveDirection + camLook
        end
        if UserInputService:IsKeyDown(Enum.KeyCode.S) then
            moveDirection = moveDirection - camLook
        end
        if UserInputService:IsKeyDown(Enum.KeyCode.A) then
            moveDirection = moveDirection - camRight
        end
        if UserInputService:IsKeyDown(Enum.KeyCode.D) then
            moveDirection = moveDirection + camRight
        end
        
        if moveDirection.Magnitude > 0 then
            moveDirection = moveDirection.Unit * targetSpeed
        end
        
        -- Smooth acceleration
        local lerpFactor = math.clamp(FlyAcceleration * deltaTime, 0, 1)
        CurrentVelocity = CurrentVelocity:Lerp(moveDirection, lerpFactor)
        
        BodyVelocity.Velocity = CurrentVelocity
        BodyGyro.CFrame = camCF
    end
end

-- RenderStepped for smooth fly and air walk
RunService.RenderStepped:Connect(function(deltaTime)
    if ScriptActive then
        UpdateFly(deltaTime)
        
        if Noclip and Character then
            for _, part in pairs(Character:GetDescendants()) do
                if part:IsA("BasePart") then
                    part.CanCollide = false
                end
            end
        end
        
        -- Update air walk platform position
        if AirWalk and AirWalkPart and RootPart then
            -- Allow height adjustment with E/Q while air walking (slower now)
            if UserInputService:IsKeyDown(Enum.KeyCode.E) then
                AirWalkTargetY = AirWalkTargetY + 0.1
            elseif UserInputService:IsKeyDown(Enum.KeyCode.Q) then
                AirWalkTargetY = AirWalkTargetY - 0.1
            end
            
            -- Raycast down to find ground
            local rayOrigin = RootPart.Position
            local rayDirection = Vector3.new(0, -100, 0)
            local raycastParams = RaycastParams.new()
            raycastParams.FilterDescendantsInstances = {Character, AirWalkPart}
            raycastParams.FilterType = Enum.RaycastFilterType.Exclude
            
            local rayResult = Workspace:Raycast(rayOrigin, rayDirection, raycastParams)
            
            -- Clamp target Y to be above ground
            if rayResult then
                local groundY = rayResult.Position.Y
                local minHeight = groundY + 3 -- Keep at least 3 studs above ground (character height buffer)
                if AirWalkTargetY < minHeight then
                    AirWalkTargetY = minHeight
                end
            end
            
            -- Move platform to stay under character
            AirWalkPart.Position = Vector3.new(RootPart.Position.X, AirWalkTargetY - 3.5, RootPart.Position.Z)
        end
        
        -- Headsit/Backpack attachment
        -- Seat is welded to target, no manual updates needed
    end
end)

-- Handle character respawn
Player.CharacterAdded:Connect(function(newCharacter)
    Character = newCharacter
    Humanoid = Character:WaitForChild("Humanoid")
    RootPart = Character:WaitForChild("HumanoidRootPart")
    NormalSpeed = Humanoid.WalkSpeed
    
    -- Connect died event to save position
    Humanoid.Died:Connect(function()
        if RespawnTPEnabled and RootPart then
            SavedPosition = RootPart.CFrame
        end
    end)
    
    -- Connect anti sit on respawn
    Humanoid.Seated:Connect(function()
        if AntiSitEnabled then
            Humanoid.PlatformStand = true
            task.wait(0.1)
            Humanoid.PlatformStand = false
            Humanoid:Jump()
        end
    end)
    
    -- Teleport back to saved position if enabled
    if RespawnTPEnabled and SavedPosition then
        task.wait(0.5) -- Wait for character to fully load
        RootPart.CFrame = SavedPosition
    end
    
    if Flying then
        DisableFly()
    end
    if SpeedBoost then
        DisableSpeed()
    end
    if AirWalk then
        DisableAirWalk()
    end
    if Noclip then
        DisableNoclip()
    end
    if TPToolActive then
        TPToolActive = false
        TPToolButton.Text = "TP TOOL: OFF"
        TPToolButton.BackgroundColor3 = Color3.fromRGB(32, 36, 55)
        if TPToolInstance then
            TPToolInstance:Destroy()
            TPToolInstance = nil
        end
    end
    if AttachmentMode then
        AttachmentMode = nil
        AttachmentLoop = false
        if AttachmentVelocity then
            AttachmentVelocity:Destroy()
            AttachmentVelocity = nil
        end
        Humanoid.Sit = false
        if OriginalWalkSpeed then
            Humanoid.WalkSpeed = OriginalWalkSpeed
        end
        HeadsitButton.BackgroundColor3 = Color3.fromRGB(32, 36, 55)
        BackpackButton.BackgroundColor3 = Color3.fromRGB(32, 36, 55)
        StandButton.BackgroundColor3 = Color3.fromRGB(32, 36, 55)
        DoggyButton.BackgroundColor3 = Color3.fromRGB(32, 36, 55)
        DragButton.BackgroundColor3 = Color3.fromRGB(32, 36, 55)
        FlingButton.BackgroundColor3 = Color3.fromRGB(32, 36, 55)
        FlingButton.Text = "FLING"
        FlingActive = false
        VCButton.Text = "VC BYPASS"
        VCButton.BackgroundColor3 = Color3.fromRGB(32, 36, 55)
        AntiAllButton.Text = "ANTI ALL"
        AntiAllButton.BackgroundColor3 = Color3.fromRGB(32, 36, 55)
        AntiAllPopup.Visible = false
        AntiAFKToggle.Text = "ANTI AFK: OFF"
        AntiAFKToggle.BackgroundColor3 = Color3.fromRGB(32, 36, 55)
        AntiSitToggle.Text = "ANTI SIT: OFF"
        AntiSitToggle.BackgroundColor3 = Color3.fromRGB(32, 36, 55)
        AntiVoidToggle.Text = "ANTI VOID: OFF"
        AntiVoidToggle.BackgroundColor3 = Color3.fromRGB(32, 36, 55)
        AntiGameplayToggle.Text = "ANTI PAUSED: OFF"
        AntiGameplayToggle.BackgroundColor3 = Color3.fromRGB(32, 36, 55)
        AntiAllEnabled = false
        AntiAFKEnabled = false
        AntiSitEnabled = false
        AntiVoidEnabled = false
        AntiGameplayPausedEnabled = false
    end
    
    -- Turn off spectate on respawn
    if SpectateActive then
        SpectateActive = false
        ViewButton.BackgroundColor3 = Color3.fromRGB(32, 36, 55)
        ViewButton.Text = "VIEW"
        if OriginalCameraSubject then
            workspace.CurrentCamera.CameraSubject = OriginalCameraSubject
            OriginalCameraSubject = nil
        else
            workspace.CurrentCamera.CameraSubject = Player.Character.Humanoid
        end
    end
end)

-- Connect died event for initial character (if it exists when script loads)
if Character and Humanoid then
    Humanoid.Died:Connect(function()
        if RespawnTPEnabled and RootPart then
            SavedPosition = RootPart.CFrame
        end
    end)
end

