local snapshotShaders, clearShaderEffects, restoreShaders, applyShaders, setShadersEnabled, setShaderTint
-- Shader functions
snapshotShaders = function()
    ShaderSnap = {
        Brightness = Lighting.Brightness,
        ExposureCompensation = Lighting.ExposureCompensation,
        ClockTime = Lighting.ClockTime,
        Ambient = Lighting.Ambient,
        OutdoorAmbient = Lighting.OutdoorAmbient,
    }
end

clearShaderEffects = function()
    for _, v in ipairs(Lighting:GetChildren()) do
        if v:IsA("Sky") or v:IsA("BloomEffect") or v:IsA("BlurEffect")
            or v:IsA("ColorCorrectionEffect") or v:IsA("SunRaysEffect") or v:IsA("Atmosphere") then
            v:Destroy()
        end
    end
end

restoreShaders = function()
    if ShaderSnap then
        Lighting.Brightness = ShaderSnap.Brightness
        Lighting.ExposureCompensation = ShaderSnap.ExposureCompensation
        Lighting.ClockTime = ShaderSnap.ClockTime
        Lighting.Ambient = ShaderSnap.Ambient
        Lighting.OutdoorAmbient = ShaderSnap.OutdoorAmbient
    end
    clearShaderEffects()
end

applyShaders = function(tint)
    clearShaderEffects()
    local cfg = SHADER_CONFIG
    tint = tint or ShaderTint or cfg.Tint
    ShaderTint = tint
    Lighting.Brightness = cfg.Brightness
    Lighting.ExposureCompensation = cfg.Exposure
    Lighting.ClockTime = cfg.ClockTime
    Lighting.Ambient = tint
    Lighting.OutdoorAmbient = tint

    local sky = Instance.new("Sky")
    sky.SkyboxBk = cfg.SkyboxBk
    sky.SkyboxDn = cfg.SkyboxDn
    sky.SkyboxFt = cfg.SkyboxFt
    sky.SkyboxLf = cfg.SkyboxLf
    sky.SkyboxRt = cfg.SkyboxRt
    sky.SkyboxUp = cfg.SkyboxUp
    sky.StarCount = cfg.StarCount
    sky.SunAngularSize = cfg.SunAngularSize
    if cfg.HeartSun and cfg.SunTextureId and cfg.SunTextureId ~= "" then
        sky.SunTextureId = cfg.SunTextureId
    end
    sky.Parent = Lighting

    local bloom = Instance.new("BloomEffect")
    bloom.Intensity = cfg.BloomIntensity
    bloom.Size = cfg.BloomSize
    bloom.Threshold = cfg.BloomThreshold
    bloom.Parent = Lighting

    local blur = Instance.new("BlurEffect")
    blur.Size = cfg.BlurSize
    blur.Parent = Lighting

    local cc = Instance.new("ColorCorrectionEffect")
    cc.Brightness = cfg.CCBrightness
    cc.Contrast = cfg.CCContrast
    cc.Saturation = cfg.CCSaturation
    cc.TintColor = tint
    cc.Parent = Lighting

    local sr = Instance.new("SunRaysEffect")
    sr.Intensity = cfg.SunRaysIntensity
    sr.Spread = cfg.SunRaysSpread
    sr.Parent = Lighting
end

setShadersEnabled = function(v)
    local ok, err = pcall(function()
        if v then
            applyShaders(ShaderTint)
        else
            restoreShaders()
        end
    end)
    if not ok then
        warn("[AETHER] Shader error: ", err)
        ShaderEnabled = false
        ShaderButton.Text = "SHADERS: OFF"
        ShaderButton.BackgroundColor3 = Color3.fromRGB(32, 36, 55)
        return
    end
    ShaderEnabled = v
    if v then
        ShaderButton.Text = "SHADERS: ON"
        ShaderButton.BackgroundColor3 = Color3.fromRGB(150, 60, 220)
    else
        ShaderButton.Text = "SHADERS: OFF"
        ShaderButton.BackgroundColor3 = Color3.fromRGB(32, 36, 55)
    end
end

setShaderTint = function(col)
    ShaderTint = col
    if ShaderEnabled then
        pcall(function()
            local cc = Lighting:FindFirstChildOfClass("ColorCorrectionEffect")
            if cc then cc.TintColor = col end
            Lighting.Ambient = col
            Lighting.OutdoorAmbient = col
        end)
    end
end


-- HSV helper
local function hsvToRgb(h, s, v)
    h = h % 1
    local i = math.floor(h * 6)
    local f = h * 6 - i
    local p, q, t = v * (1 - s), v * (1 - f * s), v * (1 - (1 - f) * s)
    i = i % 6
    if i == 0 then return v, t, p
    elseif i == 1 then return q, v, p
    elseif i == 2 then return p, v, t
    elseif i == 3 then return p, q, v
    elseif i == 4 then return t, p, v
    else return v, p, q end
end

