-- Helper to style target action buttons
local function MakeTargetBtn(name, text, xScale, yScale)
    local btn = Instance.new("TextButton")
    btn.Name = name
    btn.Size = UDim2.new(0.28, 0, 0, 36)
    btn.Position = UDim2.new(xScale, 0, yScale, 0)
    btn.BackgroundColor3 = Color3.fromRGB(32, 36, 55)
    btn.BorderSizePixel = 0
    btn.Text = text
    btn.TextColor3 = Color3.fromRGB(255, 255, 255)
    btn.TextSize = 12
    btn.Font = Enum.Font.GothamSemibold
    btn.Parent = TargetContent
    addCorner(btn, 8)
    addStroke(btn, Color3.fromRGB(160, 80, 220), 1, 0.8)
    return btn
end

