    prevLabel.Parent = card

    local prevSwatch = Instance.new("Frame")
    prevSwatch.Size = UDim2.new(0, 48, 0, 24)
    prevSwatch.Position = UDim2.new(0, 136, 0, 86)
    prevSwatch.BackgroundColor3 = ShaderTint
    prevSwatch.BorderSizePixel = 0
    prevSwatch.Parent = card
    addCorner(prevSwatch, 6)
    addStroke(prevSwatch, Color3.fromRGB(160, 80, 220), 1, 0.4)

    -- HSV state from initial tint
    local h, s, v = 0, 1, 1
    do
        local r, g, b = ShaderTint.R, ShaderTint.G, ShaderTint.B
        local maxc = math.max(r, g, b)
        local minc = math.min(r, g, b)
        v = maxc
        local d = maxc - minc
        s = (maxc == 0) and 0 or (d / maxc)
        if d == 0 then
            h = 0
        elseif maxc == r then
            h = ((g - b) / d) % 6
        elseif maxc == g then
            h = (b - r) / d + 2
        else
            h = (r - g) / d + 4
        end
        h = h / 6
    end

    local function updateVisual()
        local radius = (wheel.AbsoluteSize.X / 2) - 10
        if radius < 1 then radius = 35 end
        local angle = (h - 0.5) * math.pi * 2
        local x = math.cos(angle) * radius * s
        local y = math.sin(angle) * radius * s
        selector.Position = UDim2.new(0.5, x - 5, 0.5, y - 5)
    end

    local function push()
        local r, g, b = hsvToRgb(h, s, v)
        local col = Color3.new(r, g, b)
        center.BackgroundColor3 = col
        prevSwatch.BackgroundColor3 = col
        hexLabel.Text = string.format("#%02X%02X%02X", math.floor(r * 255 + 0.5), math.floor(g * 255 + 0.5), math.floor(b * 255 + 0.5))
        rgbLabel.Text = string.format("%d, %d, %d", math.floor(r * 255 + 0.5), math.floor(g * 255 + 0.5), math.floor(b * 255 + 0.5))
        updateVisual()
        setShaderTint(col)
        if SHADER_CONFIG.AutoEnableOnTint and not ShaderEnabled then
            setShadersEnabled(true)
        end
    end

    local draggingWheel, draggingVal = false, false

    wheel.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            draggingWheel = true
            ColorWheelActive = true
            local rel = Vector2.new(input.Position.X, input.Position.Y) - wheel.AbsolutePosition - wheel.AbsoluteSize / 2
            s = math.clamp(rel.Magnitude / math.max((wheel.AbsoluteSize.X / 2) - 7, 1), 0, 1)
            h = (math.atan2(rel.Y, rel.X) / (math.pi * 2) + 0.5) % 1
            push()
        end
    end)

    valSlider.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            draggingVal = true
            ColorWheelActive = true
            local relY = input.Position.Y - valSlider.AbsolutePosition.Y
            v = 1 - math.clamp(relY / math.max(valSlider.AbsoluteSize.Y, 1), 0, 1)
            valKnob.Position = UDim2.new(0, -3, 0, (1 - v) * (valSlider.AbsoluteSize.Y - 10))
            push()
        end
    end)

    UserInputService.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            draggingWheel = false
            draggingVal = false
            ColorWheelActive = false
        end
    end)

    UserInputService.InputChanged:Connect(function(input)
        if input.UserInputType ~= Enum.UserInputType.MouseMovement and input.UserInputType ~= Enum.UserInputType.Touch then
            return
        end
        if draggingWheel then
            local rel = Vector2.new(input.Position.X, input.Position.Y) - wheel.AbsolutePosition - wheel.AbsoluteSize / 2
            s = math.clamp(rel.Magnitude / math.max((wheel.AbsoluteSize.X / 2) - 7, 1), 0, 1)
            h = (math.atan2(rel.Y, rel.X) / (math.pi * 2) + 0.5) % 1
            push()
        elseif draggingVal then
            local relY = input.Position.Y - valSlider.AbsolutePosition.Y
            v = 1 - math.clamp(relY / math.max(valSlider.AbsoluteSize.Y, 1), 0, 1)
            valKnob.Position = UDim2.new(0, -3, 0, (1 - v) * (valSlider.AbsoluteSize.Y - 10))
            push()
        end
    end)

    task.defer(function()
        valKnob.Position = UDim2.new(0, -3, 0, (1 - v) * 80)
        updateVisual()
        local r, g, b = hsvToRgb(h, s, v)
        local col = Color3.new(r, g, b)
        center.BackgroundColor3 = col
        prevSwatch.BackgroundColor3 = col
        hexLabel.Text = string.format("#%02X%02X%02X", math.floor(r * 255 + 0.5), math.floor(g * 255 + 0.5), math.floor(b * 255 + 0.5))
        rgbLabel.Text = string.format("%d, %d, %d", math.floor(r * 255 + 0.5), math.floor(g * 255 + 0.5), math.floor(b * 255 + 0.5))
    end)
end



