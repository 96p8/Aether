-- TARGET
local TargetTab = Window:CreateTab("Target", Velox.Icons and Velox.Icons.User or nil)
TargetTab:CreateSection("Select Player")
local SelectedStatus = TargetTab:CreateStatus({ Name = "Selected", Default = "None" })

local function GetPlayerNames()
    local names = {}
    for _, p in ipairs(Players:GetPlayers()) do
        if p ~= Player then table.insert(names, p.Name) end
    end
    table.sort(names)
    return names
end

local function SelectTargetPlayer(p)
    if not p then return false end
    SelectedPlayer = p
    if SelectedStatus and SelectedStatus.Set then
        SelectedStatus.Set(p.Name)
    end
    if SpectateActive then
        SpectateActive = false
        if OriginalCameraSubject then
            Camera.CameraSubject = OriginalCameraSubject
            OriginalCameraSubject = nil
        elseif Humanoid then
            Camera.CameraSubject = Humanoid
        end
    end
    return true
end

-- Partial name match (username or display name)
local function FindPlayerByTypedName(text)
    if not text or text == "" then return nil end
    local input = string.lower(text)
    local best, bestScore = nil, 0
    for _, p in ipairs(Players:GetPlayers()) do
        if p ~= Player then
            local n = string.lower(p.Name)
            local d = string.lower(p.DisplayName)
            if n == input or d == input then
                return p -- exact match wins
            end
            local score = 0
            if string.sub(n, 1, #input) == input then score = #input + 10
            elseif string.find(n, input, 1, true) then score = #input
            elseif string.sub(d, 1, #input) == input then score = #input + 5
            elseif string.find(d, input, 1, true) then score = #input - 1
            end
            if score > bestScore then
                bestScore = score
                best = p
            end
        end
    end
    return best
end

-- Type-in player name box
do
    local theme = Window.Theme or (Velox.Themes and Velox.Themes.Obsidian) or {
        Secondary = Color3.fromRGB(17, 18, 24),
        Text = Color3.fromRGB(250, 250, 255),
        TextDim = Color3.fromRGB(170, 175, 190),
        TextDark = Color3.fromRGB(115, 120, 138),
        Accent = Color3.fromRGB(185, 110, 255),
        InputBackground = Color3.fromRGB(14, 15, 20),
        Tertiary = Color3.fromRGB(24, 26, 34),
    }
    local parent = nil
    if SelectedStatus and SelectedStatus.Frame then
        parent = SelectedStatus.Frame.Parent
    end
    if parent then
        local card = Instance.new("Frame")
        card.Name = "PlayerNameInputCard"
        card.BackgroundColor3 = theme.Secondary
        card.Size = UDim2.new(1, -6, 0, 48)
        card.Parent = parent
        local corner = Instance.new("UICorner")
        corner.CornerRadius = UDim.new(0, 8)
        corner.Parent = card

        local label = Instance.new("TextLabel")
        label.BackgroundTransparency = 1
        label.Size = UDim2.new(0.35, 0, 1, 0)
        label.Position = UDim2.fromOffset(12, 0)
        label.Font = Enum.Font.GothamSemibold
        label.Text = "Type Name"
        label.TextColor3 = theme.Text
        label.TextSize = 12
        label.TextXAlignment = Enum.TextXAlignment.Left
        label.Parent = card

        local box = Instance.new("TextBox")
        box.Name = "PlayerNameBox"
        box.BackgroundColor3 = theme.InputBackground or theme.Tertiary
        box.Size = UDim2.new(0.58, -8, 0, 28)
        box.Position = UDim2.new(0.38, 0, 0.5, -14)
        box.Font = Enum.Font.Gotham
        box.Text = ""
        box.PlaceholderText = "username..."
        box.PlaceholderColor3 = theme.TextDark
        box.TextColor3 = theme.Text
        box.TextSize = 12
        box.ClearTextOnFocus = false
        box.Parent = card
        local boxCorner = Instance.new("UICorner")
        boxCorner.CornerRadius = UDim.new(0, 6)
        boxCorner.Parent = box
        local boxStroke = Instance.new("UIStroke")
        boxStroke.Color = theme.Accent
        boxStroke.Thickness = 1
        boxStroke.Transparency = 0.7
        boxStroke.Parent = box

        local function trySelect()
            local typed = box.Text
            if typed == "" then return end
            local p = FindPlayerByTypedName(typed)
            if p then
                SelectTargetPlayer(p)
                box.Text = p.Name
                safeNotify("Target", "Selected " .. p.Name, "Success", 2)
            else
                safeNotify("Target", "Player not found: " .. typed, "Warning", 2)
                if SelectedStatus and SelectedStatus.Set then
                    SelectedStatus.Set("Not found")
                end
            end
        end

        box.FocusLost:Connect(function(enter)
            if enter then trySelect() end
        end)
        -- also select when they finish typing and click away
        box.FocusLost:Connect(function()
            if box.Text ~= "" and not SelectedPlayer then
                trySelect()
            elseif box.Text ~= "" then
                trySelect()
            end
        end)
    end
end

