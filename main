TargetTab:CreateSection("Attach Modes")

do
function StopAttachment()
    AttachmentMode = nil
    AttachmentLoop = false
    if AttachmentVelocity then AttachmentVelocity:Destroy() AttachmentVelocity = nil end
    if Humanoid then
        Humanoid.Sit = false
        Humanoid.PlatformStand = false
        pcall(function() Humanoid:ChangeState(Enum.HumanoidStateType.Freefall) end)
        Humanoid.WalkSpeed = OriginalWalkSpeed or NormalSpeed
    end
end

function StartAttachment(mode, offsetFunc)
    if not SelectedPlayer or not SelectedPlayer.Character or not RootPart then
        safeNotify("Target", "Select a player first", "Warning", 2)
        return
    end
    if AttachmentMode == mode then StopAttachment() return end
    StopAttachment()
    AttachmentMode = mode
    OriginalWalkSpeed = Humanoid.WalkSpeed
    Humanoid.WalkSpeed = 0
    if not AttachmentVelocity then
        AttachmentVelocity = Instance.new("BodyAngularVelocity")
        AttachmentVelocity.Name = "AttachmentVelocity"
        AttachmentVelocity.MaxTorque = Vector3.new(math.huge, math.huge, math.huge)
        AttachmentVelocity.AngularVelocity = Vector3.new(0, 0, 0)
        AttachmentVelocity.Parent = RootPart
    end
    AttachmentLoop = true
    task.spawn(function()
        while AttachmentLoop and SelectedPlayer and SelectedPlayer.Character and AttachmentMode == mode and ScriptActive do
            pcall(function()
                local cf = offsetFunc(SelectedPlayer.Character)
                if cf and RootPart then
                    RootPart.CFrame = cf
                    RootPart.AssemblyLinearVelocity = Vector3.new(0, 0, 0)
                end
            end)
            task.wait()
        end
    end)
end
end

TargetTab:CreateButton({
    Name = "Headsit",
    Callback = function()
        StartAttachment("headsit", function(char)
            local head = char:FindFirstChild("Head") or char:FindFirstChild("HumanoidRootPart")
            if head then Humanoid.Sit = true return head.CFrame * CFrame.new(0, 2, 0) end
        end)
    end,
})
TargetTab:CreateButton({
    Name = "Backpack",
    Callback = function()
        StartAttachment("backpack", function(char)
            local root = char:FindFirstChild("HumanoidRootPart")
            if root then Humanoid.Sit = true return root.CFrame * CFrame.new(0, 0, 1.2) * CFrame.Angles(0, math.rad(-90), 0) end
        end)
    end,
})
TargetTab:CreateButton({
    Name = "Stand",
    Callback = function()
        StartAttachment("stand", function(char)
            local root = char:FindFirstChild("HumanoidRootPart")
            if root then return root.CFrame * CFrame.new(-3, 1, 0) end
        end)
    end,
})
TargetTab:CreateButton({
    Name = "Doggy",
    Callback = function()
        StartAttachment("doggy", function(char)
            local part = char:FindFirstChild("LowerTorso") or char:FindFirstChild("Torso") or char:FindFirstChild("HumanoidRootPart")
            if part then return part.CFrame * CFrame.new(0, 0.23, 0) end
        end)
    end,
})
TargetTab:CreateButton({
    Name = "Drag",
    Callback = function()
        StartAttachment("drag", function(char)
            local hand = char:FindFirstChild("RightHand") or char:FindFirstChild("Right Arm") or char:FindFirstChild("HumanoidRootPart")
            if hand then return hand.CFrame * CFrame.new(0, -2.5, 1) * CFrame.Angles(math.rad(-90), math.rad(-90), 0) end
        end)
    end,
})
TargetTab:CreateButton({ Name = "Stop Attach", Callback = StopAttachment })

TargetTab:CreateSection("Actions")
TargetTab:CreateButton({
    Name = "Teleport to Target",
    Callback = function()
        if not SelectedPlayer or not SelectedPlayer.Character or not RootPart then return end
        local tr = SelectedPlayer.Character:FindFirstChild("HumanoidRootPart")
        if not tr then return end
        task.spawn(function()
            for _ = 1, 20 do
                if not RootPart then break end
                RootPart.AssemblyLinearVelocity = Vector3.new(0, 0, 0)
                RootPart.CFrame = tr.CFrame * CFrame.new(0, 2, 0)
                task.wait()
            end
        end)
    end,
})
TargetTab:CreateToggle({
    Name = "View / Spectate",
    Default = false,
    Callback = function(state)
        if state then
            if SelectedPlayer and SelectedPlayer.Character then
                local tr = SelectedPlayer.Character:FindFirstChild("HumanoidRootPart")
                if tr then
                    SpectateActive = true
                    OriginalCameraSubject = Camera.CameraSubject
                    Camera.CameraSubject = tr
                    return
                end
            end
            SpectateActive = false
        else
            SpectateActive = false
            if OriginalCameraSubject then
                Camera.CameraSubject = OriginalCameraSubject
                OriginalCameraSubject = nil
            elseif Humanoid then
                Camera.CameraSubject = Humanoid
            end
        end
    end,
})
TargetTab:CreateToggle({
    Name = "Fling",
    Default = false,
    Callback = function(state)
        if not state then FlingActive = false return end
        if not SelectedPlayer or not SelectedPlayer.Character or not RootPart then FlingActive = false return end
        FlingActive = true
        local savedPos = RootPart.CFrame
        task.spawn(function()
            local bv = Instance.new("BodyVelocity")
            bv.Name = "FlingBV"
            bv.MaxForce = Vector3.new(math.huge, math.huge, math.huge)
            bv.Velocity = Vector3.new(0, 0, 0)
            bv.Parent = RootPart
            while FlingActive and SelectedPlayer and SelectedPlayer.Character and RootPart and ScriptActive do
                pcall(function()
                    local tr = SelectedPlayer.Character:FindFirstChild("HumanoidRootPart")
                    if tr then
                        RootPart.CFrame = tr.CFrame
                        bv.Velocity = Vector3.new(9999, 9999, 9999)
                    end
                end)
                task.wait()
            end
            if bv then bv:Destroy() end
            if RootPart then
                RootPart.AssemblyLinearVelocity = Vector3.new(0, 0, 0)
                RootPart.CFrame = savedPos
            end
            FlingActive = false
        end)
    end,
})

