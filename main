                status.ok = a and true or false
                status.reason = b
            end)
            if not callOk then
                safeNotify("VC Bypass V2", tostring(err or "Error"), "Error", 4)
            elseif status.ok then
                safeNotify("VC Bypass V2", "Success", "Success", 3)
