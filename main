-- =========================
-- CONFIG SYSTEM (all state is declared above)
-- =========================
buildConfig = function()
    return {
        name = CurrentConfigName or "default",
        version = 1,
        movement = {
            flySpeed = FlySpeed,
            boostSpeed = BoostSpeed,
            minSpeed = MinSpeed,
            maxSpeed = MaxSpeed,
            minBoostSpeed = MinBoostSpeed,
            maxBoostSpeed = MaxBoostSpeed,
            flyAcceleration = FlyAcceleration,
            flySprintMultiplier = FlySprintMultiplier,
            airWalk = AirWalk and true or false,
            noclip = Noclip and true or false,
            tpTool = TPToolActive and true or false,
            flying = Flying and true or false,
            speedBoost = SpeedBoost and true or false,
        },
        anti = {
            respawnTP = RespawnTPEnabled and true or false,
            antiAFK = AntiAFKEnabled and true or false,
            antiSit = AntiSitEnabled and true or false,
            antiVoid = AntiVoidEnabled and true or false,
            antiPaused = AntiGameplayPausedEnabled and true or false,
        },
        shaders = {
            enabled = ShaderEnabled and true or false,
            tint = colorToTable(ShaderTint),
            brightness = SHADER_CONFIG.Brightness,
            exposure = SHADER_CONFIG.Exposure,
            clockTime = SHADER_CONFIG.ClockTime,
            starCount = SHADER_CONFIG.StarCount,
            sunAngularSize = SHADER_CONFIG.SunAngularSize,
            heartSun = SHADER_CONFIG.HeartSun and true or false,
            sunTextureId = SHADER_CONFIG.SunTextureId,
            bloomIntensity = SHADER_CONFIG.BloomIntensity,
            bloomSize = SHADER_CONFIG.BloomSize,
            bloomThreshold = SHADER_CONFIG.BloomThreshold,
            blurSize = SHADER_CONFIG.BlurSize,
            ccBrightness = SHADER_CONFIG.CCBrightness,
            ccContrast = SHADER_CONFIG.CCContrast,
            ccSaturation = SHADER_CONFIG.CCSaturation,
            sunRaysIntensity = SHADER_CONFIG.SunRaysIntensity,
            sunRaysSpread = SHADER_CONFIG.SunRaysSpread,
            autoEnableOnTint = SHADER_CONFIG.AutoEnableOnTint and true or false,
        },
    }
end

encodeConfig = function(cfg)
    local ok, result = pcall(function()
        return game:GetService("HttpService"):JSONEncode(cfg)
    end)
    if ok and result then return result end
    -- minimal fallback encoder for our structure
    return nil
end

decodeConfig = function(str)
    local ok, result = pcall(function()
        return game:GetService("HttpService"):JSONDecode(str)
    end)
    if ok then return result end
    return nil
end

applyConfig = function(cfg)
    if type(cfg) ~= "table" then return false, "invalid config" end
    if cfg.name then CurrentConfigName = tostring(cfg.name) end

    if type(cfg.movement) == "table" then
        local m = cfg.movement
        if tonumber(m.flySpeed) then FlySpeed = tonumber(m.flySpeed) end
        if tonumber(m.boostSpeed) then BoostSpeed = tonumber(m.boostSpeed) end
        if tonumber(m.minSpeed) then MinSpeed = tonumber(m.minSpeed) end
        if tonumber(m.maxSpeed) then MaxSpeed = tonumber(m.maxSpeed) end
        if tonumber(m.minBoostSpeed) then MinBoostSpeed = tonumber(m.minBoostSpeed) end
        if tonumber(m.maxBoostSpeed) then MaxBoostSpeed = tonumber(m.maxBoostSpeed) end
        if tonumber(m.flyAcceleration) then FlyAcceleration = tonumber(m.flyAcceleration) end
        if tonumber(m.flySprintMultiplier) then FlySprintMultiplier = tonumber(m.flySprintMultiplier) end

        -- Feature toggles (actually enable/disable, not just set flags)
        if m.airWalk ~= nil then
            if m.airWalk and not AirWalk then
                pcall(EnableAirWalk)
            elseif not m.airWalk and AirWalk then
                pcall(DisableAirWalk)
            end
        end
        if m.noclip ~= nil then
            if m.noclip and not Noclip then
                pcall(EnableNoclip)
            elseif not m.noclip and Noclip then
                pcall(DisableNoclip)
            end
        end
        if m.flying ~= nil then
            if m.flying and not Flying then
                pcall(EnableFly)
            elseif not m.flying and Flying then
                pcall(DisableFly)
            end
        end
        if m.speedBoost ~= nil then
            if m.speedBoost and not SpeedBoost then
                pcall(EnableSpeed)
            elseif not m.speedBoost and SpeedBoost then
                pcall(DisableSpeed)
            end
        end
        if m.tpTool ~= nil then
            if m.tpTool and not TPToolActive then
                TPToolActive = true
                if TPToolButton then
                    TPToolButton.Text = "TP TOOL: ON"
                    TPToolButton.BackgroundColor3 = Color3.fromRGB(150, 60, 220)
                end
                if not TPToolInstance or not TPToolInstance.Parent then
                    TPToolInstance = Instance.new("Tool")
                    TPToolInstance.Name = "TP Tool"
                    TPToolInstance.RequiresHandle = false
                    TPToolInstance.Parent = Player.Backpack
                    TPToolInstance.Activated:Connect(function()
                        if RootPart and Mouse then
                            local targetPos = Mouse.Hit.Position
                            if AirWalk and AirWalkPart then
                                local newPos = Vector3.new(targetPos.X, AirWalkTargetY, targetPos.Z)
                                RootPart.CFrame = CFrame.new(newPos)
                                AirWalkPart.Position = Vector3.new(newPos.X, AirWalkTargetY - 3.5, newPos.Z)
                            else
                                RootPart.CFrame = CFrame.new(targetPos)
                            end
                        end
                    end)
                end
            elseif not m.tpTool and TPToolActive then
                TPToolActive = false
                if TPToolButton then
                    TPToolButton.Text = "TP TOOL: OFF"
                    TPToolButton.BackgroundColor3 = Color3.fromRGB(32, 36, 55)
                end
                if TPToolInstance then
                    TPToolInstance:Destroy()
                    TPToolInstance = nil
                end
            end
        end
    end

    if type(cfg.anti) == "table" then
        local a = cfg.anti
        if a.respawnTP ~= nil then RespawnTPEnabled = a.respawnTP and true or false end
        if a.antiAFK ~= nil then AntiAFKEnabled = a.antiAFK and true or false end
        if a.antiSit ~= nil then AntiSitEnabled = a.antiSit and true or false end
        if a.antiVoid ~= nil then AntiVoidEnabled = a.antiVoid and true or false end
        if a.antiPaused ~= nil then AntiGameplayPausedEnabled = a.antiPaused and true or false end
    end

    if type(cfg.shaders) == "table" then
        local s = cfg.shaders
        if s.tint then
            ShaderTint = tableToColor(s.tint)
            SHADER_CONFIG.Tint = ShaderTint
        end
        if s.brightness ~= nil then SHADER_CONFIG.Brightness = s.brightness end
        if s.exposure ~= nil then SHADER_CONFIG.Exposure = s.exposure end
        if s.clockTime ~= nil then SHADER_CONFIG.ClockTime = s.clockTime end
        if s.starCount ~= nil then SHADER_CONFIG.StarCount = s.starCount end
        if s.sunAngularSize ~= nil then SHADER_CONFIG.SunAngularSize = s.sunAngularSize end
        if s.heartSun ~= nil then SHADER_CONFIG.HeartSun = s.heartSun and true or false end
        if s.sunTextureId ~= nil then SHADER_CONFIG.SunTextureId = s.sunTextureId end
        if s.bloomIntensity ~= nil then SHADER_CONFIG.BloomIntensity = s.bloomIntensity end
        if s.bloomSize ~= nil then SHADER_CONFIG.BloomSize = s.bloomSize end
        if s.bloomThreshold ~= nil then SHADER_CONFIG.BloomThreshold = s.bloomThreshold end
        if s.blurSize ~= nil then SHADER_CONFIG.BlurSize = s.blurSize end
        if s.ccBrightness ~= nil then SHADER_CONFIG.CCBrightness = s.ccBrightness end
        if s.ccContrast ~= nil then SHADER_CONFIG.CCContrast = s.ccContrast end
        if s.ccSaturation ~= nil then SHADER_CONFIG.CCSaturation = s.ccSaturation end
        if s.sunRaysIntensity ~= nil then SHADER_CONFIG.SunRaysIntensity = s.sunRaysIntensity end
        if s.sunRaysSpread ~= nil then SHADER_CONFIG.SunRaysSpread = s.sunRaysSpread end
        if s.autoEnableOnTint ~= nil then SHADER_CONFIG.AutoEnableOnTint = s.autoEnableOnTint and true or false end
        if s.enabled == true then
            pcall(function() setShadersEnabled(true) end)
        elseif s.enabled == false then
            pcall(function() if ShaderEnabled then setShadersEnabled(false) end end)
        end
    end
    return true
end

saveConfigToFile = function(name)
    name = tostring(name or CurrentConfigName or "default")
    if name == "" then name = "default" end
    CurrentConfigName = name
    local cfg = buildConfig()
    cfg.name = name
    local json = encodeConfig(cfg)
    if not json then
        return false, "JSON encode failed (HttpService)"
    end
    local file = "aether_" .. name:gsub("[^%w%-_]", "_") .. ".json"
    local savedPath = nil

    if writefile then
        -- primary path
        local ok = pcall(writefile, file, json)
        if ok then savedPath = file end
        -- folder path
        if not savedPath then
            if makefolder then pcall(makefolder, "AetherConfigs") end
            ok = pcall(writefile, "AetherConfigs/" .. file, json)
            if ok then savedPath = "AetherConfigs/" .. file end
        end
        -- remember which config to auto-load next execute
        pcall(writefile, "aether_autoload.txt", name)
    end

    if savedPath then
        return true, savedPath
    end

    if setclipboard then
        pcall(setclipboard, json)
        return true, "copied to clipboard (no writefile)"
    end
    print("[AETHER CONFIG]", json)
    return false, "no writefile — printed JSON to console"
end

loadConfigFromFile = function(name)
    name = tostring(name or CurrentConfigName or "default")
    if name == "" then name = "default" end
    local safe = name:gsub("[^%w%-_]", "_")
    local candidates = {
        "aether_" .. safe .. ".json",
        "AetherConfigs/aether_" .. safe .. ".json",
        "aether_config.json",
        safe .. ".json",
    }

    local data, usedFile = nil, nil
    if not readfile then
        return false, "readfile not available on this executor"
    end

    for _, path in ipairs(candidates) do
        local ok, content = pcall(readfile, path)
        if ok and type(content) == "string" and content ~= "" then
            data = content
            usedFile = path
            break
        end
    end

    -- try listfiles scan as last resort
    if not data and listfiles then
        local ok, files = pcall(listfiles, "")
        if ok and type(files) == "table" then
            for _, path in ipairs(files) do
                if type(path) == "string" and path:lower():find("aether_" .. safe:lower()) then
                    local ok2, content = pcall(readfile, path)
                    if ok2 and content and content ~= "" then
                        data = content
                        usedFile = path
                        break
                    end
                end
            end
        end
    end

    if not data then
        return false, "file not found: aether_" .. safe .. ".json — save a config first"
    end

    local cfg = decodeConfig(data)
    if not cfg then return false, "JSON decode failed for " .. tostring(usedFile) end
    local ok, err = applyConfig(cfg)
    if not ok then return false, tostring(err) end
    CurrentConfigName = cfg.name or name
    return true, usedFile
end

refreshConfigUI = function()
    pcall(function()
        if SpeedLabel then SpeedLabel.Text = "Fly Speed: " .. tostring(math.floor(FlySpeed)) end
        if BoostLabel then BoostLabel.Text = "Boost Speed: " .. tostring(math.floor(BoostSpeed)) end
        if SliderFill and SliderHandle and MaxSpeed and MinSpeed then
            local pct = math.clamp((FlySpeed - MinSpeed) / math.max(MaxSpeed - MinSpeed, 1), 0, 1)
            SliderFill.Size = UDim2.new(pct, 0, 1, 0)
            SliderHandle.Position = UDim2.new(pct, -8, 0, -4)
        end
        if BoostSliderFill and BoostSliderHandle and MaxBoostSpeed and MinBoostSpeed then
            local pct = math.clamp((BoostSpeed - MinBoostSpeed) / math.max(MaxBoostSpeed - MinBoostSpeed, 1), 0, 1)
            BoostSliderFill.Size = UDim2.new(pct, 0, 1, 0)
            BoostSliderHandle.Position = UDim2.new(pct, -8, 0.5, -8)
        end
        if RespawnTPButton then
            RespawnTPButton.Text = RespawnTPEnabled and "RESPAWN TP: ON" or "RESPAWN TP: OFF"
            RespawnTPButton.BackgroundColor3 = RespawnTPEnabled and Color3.fromRGB(150, 60, 220) or Color3.fromRGB(32, 36, 55)
        end
        if AntiAFKToggle then
            AntiAFKToggle.Text = AntiAFKEnabled and "ANTI AFK: ON" or "ANTI AFK: OFF"
            AntiAFKToggle.BackgroundColor3 = AntiAFKEnabled and Color3.fromRGB(150, 60, 220) or Color3.fromRGB(32, 36, 55)
        end
        if AntiSitToggle then
            AntiSitToggle.Text = AntiSitEnabled and "ANTI SIT: ON" or "ANTI SIT: OFF"
            AntiSitToggle.BackgroundColor3 = AntiSitEnabled and Color3.fromRGB(150, 60, 220) or Color3.fromRGB(32, 36, 55)
        end
        if AntiVoidToggle then
            AntiVoidToggle.Text = AntiVoidEnabled and "ANTI VOID: ON" or "ANTI VOID: OFF"
            AntiVoidToggle.BackgroundColor3 = AntiVoidEnabled and Color3.fromRGB(150, 60, 220) or Color3.fromRGB(32, 36, 55)
        end
        if AntiGameplayToggle then
            AntiGameplayToggle.Text = AntiGameplayPausedEnabled and "ANTI PAUSED: ON" or "ANTI PAUSED: OFF"
            AntiGameplayToggle.BackgroundColor3 = AntiGameplayPausedEnabled and Color3.fromRGB(150, 60, 220) or Color3.fromRGB(32, 36, 55)
        end
        if ConfigNameBox then ConfigNameBox.Text = CurrentConfigName end
        if ShaderButton then
            ShaderButton.Text = ShaderEnabled and "SHADERS: ON" or "SHADERS: OFF"
            ShaderButton.BackgroundColor3 = ShaderEnabled and Color3.fromRGB(150, 60, 220) or Color3.fromRGB(32, 36, 55)
        end
        if AirWalkButton then
            AirWalkButton.Text = AirWalk and "AIR WALK: ON" or "AIR WALK: OFF"
            AirWalkButton.BackgroundColor3 = AirWalk and Color3.fromRGB(150, 60, 220) or Color3.fromRGB(32, 36, 55)
        end
        if NoclipButton then
            NoclipButton.Text = Noclip and "NOCLIP: ON" or "NOCLIP: OFF"
            NoclipButton.BackgroundColor3 = Noclip and Color3.fromRGB(150, 60, 220) or Color3.fromRGB(32, 36, 55)
        end
        if TPToolButton then
            TPToolButton.Text = TPToolActive and "TP TOOL: ON" or "TP TOOL: OFF"
            TPToolButton.BackgroundColor3 = TPToolActive and Color3.fromRGB(150, 60, 220) or Color3.fromRGB(32, 36, 55)
        end
        if FlyButton then
            FlyButton.Text = Flying and "FLY: ON" or "FLY: OFF"
            FlyButton.BackgroundColor3 = Flying and Color3.fromRGB(150, 60, 220) or Color3.fromRGB(32, 36, 55)
        end
        if SpeedButton then
            SpeedButton.Text = SpeedBoost and "SPEED: ON" or "SPEED: OFF"
            SpeedButton.BackgroundColor3 = SpeedBoost and Color3.fromRGB(150, 60, 220) or Color3.fromRGB(32, 36, 55)
        end
    end)
end

SaveConfigButton.MouseButton1Click:Connect(function()
    local name = ConfigNameBox and ConfigNameBox.Text or "default"
    if name == "" then name = "default" end
    local ok, msg = saveConfigToFile(name)
    if ConfigStatusLabel then
        ConfigStatusLabel.Text = ok and ("Saved: " .. tostring(msg)) or ("Save failed: " .. tostring(msg))
        ConfigStatusLabel.TextColor3 = ok and Color3.fromRGB(100, 255, 140) or Color3.fromRGB(255, 100, 100)
    end
    print("[AETHER] Save config:", ok, msg)
end)

LoadConfigButton.MouseButton1Click:Connect(function()
    local name = ConfigNameBox and ConfigNameBox.Text or "default"
    if name == "" then name = "default" end
    local ok, msg = loadConfigFromFile(name)
    if ok then
        refreshConfigUI()
    end
    if ConfigStatusLabel then
        ConfigStatusLabel.Text = ok and ("Loaded: " .. tostring(msg)) or ("Load failed: " .. tostring(msg))
        ConfigStatusLabel.TextColor3 = ok and Color3.fromRGB(100, 255, 140) or Color3.fromRGB(255, 100, 100)
    end
    print("[AETHER] Load config:", ok, msg)
end)

-- Auto-load config on execute
task.spawn(function()
    -- Wait for character so Air Walk / Noclip / TP Tool can enable cleanly
    local char = Player.Character
    if not char then
        char = Player.CharacterAdded:Wait()
    end
    if char then
        char:WaitForChild("HumanoidRootPart", 5)
        char:WaitForChild("Humanoid", 5)
    end
    task.wait(AUTO_LOAD_DELAY or 0.5)

    -- Resolve which config to load:
    -- 1) aether_autoload.txt (written when you SAVE)
    -- 2) AUTO_LOAD_CONFIG at top of script
    local name = nil
    if readfile then
        local ok, content = pcall(readfile, "aether_autoload.txt")
        if ok and type(content) == "string" then
            content = content:gsub("%s+", "")
            if content ~= "" then name = content end
        end
    end
    if not name or name == "" then
        name = AUTO_LOAD_CONFIG
    end
    if not name or name == "" then
        print("[AETHER] Auto-load disabled (no name set)")
        return
    end

    print("[AETHER] Auto-loading config:", name)

    local ok, msg
    for attempt = 1, 3 do
        ok, msg = loadConfigFromFile(name)
        if ok then break end
        task.wait(0.4)
    end

    if ok then
        refreshConfigUI()
        if ConfigNameBox then ConfigNameBox.Text = name end
        if ConfigStatusLabel then
            ConfigStatusLabel.Text = "Auto-loaded: " .. tostring(msg)
            ConfigStatusLabel.TextColor3 = Color3.fromRGB(100, 255, 140)
        end
        print("[AETHER] Auto-loaded OK:", name, msg)
    else
        if ConfigStatusLabel then
            ConfigStatusLabel.Text = "Auto-load failed: " .. tostring(msg)
            ConfigStatusLabel.TextColor3 = Color3.fromRGB(255, 180, 80)
        end
        print("[AETHER] Auto-load FAILED:", name, msg)
        print("[AETHER] Tip: open Misc, turn features on, SAVE CONFIG as '" .. tostring(name) .. "' first")
    end
end)


-- Anti AFK
RunService.Heartbeat:Connect(function()
    if AntiAFKEnabled then
        -- Simulate activity
        local VirtualInput = game:GetService("VirtualInputManager")
        VirtualInput:SendKeyEvent(false, Enum.KeyCode.W)
        task.wait()
        VirtualInput:SendKeyEvent(true, Enum.KeyCode.W)
    end
end)

-- Anti Sit (initial character)
if Character and Humanoid then
    Humanoid.Seated:Connect(function()
        if AntiSitEnabled then
            Humanoid.PlatformStand = true
            task.wait(0.1)
            Humanoid.PlatformStand = false
            Humanoid:Jump()
        end
    end)
end

-- Anti Void
RunService.RenderStepped:Connect(function()
    if AntiVoidEnabled and RootPart then
        if RootPart.Position.Y < -100 then
            RootPart.CFrame = CFrame.new(RootPart.Position.X, 10, RootPart.Position.Z)
            RootPart.Velocity = Vector3.new(0, 100, 0)
        end
    end
end)

-- Anti Gameplay Paused
local function simulateActivity()
    local VirtualInput = game:GetService("VirtualInputManager")
    pcall(function()
        VirtualInput:SendKeyEvent(true, Enum.KeyCode.W)
        task.wait()
        VirtualInput:SendKeyEvent(false, Enum.KeyCode.W)
    end)
    pcall(function()
        VirtualInput:SendMouseButtonEvent(Enum.UserInputType.MouseButton1, true)
        task.wait()
        VirtualInput:SendMouseButtonEvent(Enum.UserInputType.MouseButton1, false)
    end)
    pcall(function()
        VirtualInput:SendMouseMoveEvent(1, 1)
    end)
end

game:GetService("Players").LocalPlayer.Idled:Connect(function(time)
    if AntiGameplayPausedEnabled then
        simulateActivity()
    end
end)

-- Continuous activity simulation
task.spawn(function()
    while true do
        if AntiGameplayPausedEnabled then
            simulateActivity()
        end
        task.wait(10)
    end
end)

-- TP Tool now uses tool in inventory, no mouse handler needed

-- Slider logic
local SliderDragging = false
local SliderActive = false

-- Boost Slider logic
local BoostSliderDragging = false
local BoostSliderActive = false

local function UpdateSlider(value)
    local clampedValue = math.clamp(value, MinSpeed, MaxSpeed)
    local percent = (clampedValue - MinSpeed) / (MaxSpeed - MinSpeed)
    
    FlySpeed = clampedValue
    SpeedLabel.Text = "Fly Speed: " .. math.floor(FlySpeed)
    SliderFill.Size = UDim2.new(percent, 0, 1, 0)
    SliderHandle.Position = UDim2.new(percent, -8, 0, -4)
end

local function GetSpeedFromMouse()
    local mousePos = UserInputService:GetMouseLocation().X
    local trackPos = SliderTrack.AbsolutePosition.X
    local trackSize = SliderTrack.AbsoluteSize.X
    local percent = (mousePos - trackPos) / trackSize
    local speedValue = MinSpeed + (percent * (MaxSpeed - MinSpeed))
    UpdateSlider(speedValue)
end

SliderHandle.MouseButton1Down:Connect(function()
    SliderDragging = true
    SliderActive = true
end)

SliderTrack.MouseButton1Down:Connect(function()
    SliderDragging = true
    SliderActive = true
    GetSpeedFromMouse()
end)

UserInputService.InputEnded:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 then
        SliderDragging = false
        SliderActive = false
        BoostSliderDragging = false
        BoostSliderActive = false
    end
end)

UserInputService.InputChanged:Connect(function(input)
    if SliderDragging and input.UserInputType == Enum.UserInputType.MouseMovement then
        GetSpeedFromMouse()
    end
end)

-- Initialize slider at current speed
UpdateSlider(FlySpeed)

-- Boost slider functions
local function UpdateBoostSlider(value)
    local clampedValue = math.clamp(value, MinBoostSpeed, MaxBoostSpeed)
    local percent = (clampedValue - MinBoostSpeed) / (MaxBoostSpeed - MinBoostSpeed)
    
    BoostSpeed = clampedValue
    BoostLabel.Text = "Boost Speed: " .. math.floor(BoostSpeed)
    BoostSliderFill.Size = UDim2.new(percent, 0, 1, 0)
    BoostSliderHandle.Position = UDim2.new(percent, -9, 0, -4)
    
    -- Update walkspeed if speed boost is active
    if SpeedBoost then
        Humanoid.WalkSpeed = BoostSpeed
    end
end

local function GetBoostSpeedFromMouse()
    local mousePos = UserInputService:GetMouseLocation().X
    local trackPos = BoostSliderTrack.AbsolutePosition.X
    local trackSize = BoostSliderTrack.AbsoluteSize.X
    local percent = (mousePos - trackPos) / trackSize
    local speedValue = MinBoostSpeed + (percent * (MaxBoostSpeed - MinBoostSpeed))
    UpdateBoostSlider(speedValue)
end

BoostSliderHandle.MouseButton1Down:Connect(function()
    BoostSliderDragging = true
    BoostSliderActive = true
end)

BoostSliderTrack.MouseButton1Down:Connect(function()
    BoostSliderDragging = true
    BoostSliderActive = true
    GetBoostSpeedFromMouse()
end)

UserInputService.InputChanged:Connect(function(input)
    if BoostSliderDragging and input.UserInputType == Enum.UserInputType.MouseMovement then
        GetBoostSpeedFromMouse()
    end
end)

-- Initialize boost slider at current boost speed
UpdateBoostSlider(BoostSpeed)

-- Tab switching logic
local function SwitchTab(tabName)
    local activeBg = Color3.fromRGB(140, 60, 200)
    local inactiveBg = Color3.fromRGB(28, 30, 48)
    local activeText = Color3.fromRGB(255, 255, 255)
    local inactiveText = Color3.fromRGB(160, 170, 200)

    local function style(tab, on)
        tab.BackgroundColor3 = on and activeBg or inactiveBg
        tab.TextColor3 = on and activeText or inactiveText
        tab.Font = on and Enum.Font.GothamBold or Enum.Font.GothamSemibold
    end

    MovementContent.Visible = (tabName == "Movement")
    TargetContent.Visible = (tabName == "Target")
    SettingsContent.Visible = (tabName == "Misc")
    SettingsTabContent.Visible = (tabName == "Settings")

    style(Tab1, tabName == "Movement")
    style(Tab2, tabName == "Target")
    style(Tab3, tabName == "Misc")
    style(Tab4, tabName == "Settings")

    if tabName == "Target" then
        UpdatePlayerList()
    end
end

Tab1.MouseButton1Click:Connect(function()
    SwitchTab("Movement")
end)

Tab2.MouseButton1Click:Connect(function()
    SwitchTab("Target")
end)

Tab3.MouseButton1Click:Connect(function()
    SwitchTab("Misc")
end)

Tab4.MouseButton1Click:Connect(function()
    SwitchTab("Settings")
end)

-- Player list update function
local function UpdatePlayerList()
    -- Clear existing buttons
    for _, child in ipairs(PlayerListFrame:GetChildren()) do
        if child:IsA("TextButton") then
            child:Destroy()
        end
    end
    
    -- Add buttons for each player
    for _, targetPlayer in ipairs(Players:GetPlayers()) do
        if targetPlayer ~= Player then
            local PlayerButton = Instance.new("TextButton")
            PlayerButton.Name = targetPlayer.Name
            PlayerButton.Size = UDim2.new(1, 0, 0, 38)
            PlayerButton.BackgroundColor3 = Color3.fromRGB(36, 40, 62)
            PlayerButton.BorderSizePixel = 0
            PlayerButton.Text = ""
            PlayerButton.TextColor3 = Color3.fromRGB(255, 255, 255)
            PlayerButton.TextSize = 14
            PlayerButton.Font = Enum.Font.GothamSemibold
            PlayerButton.TextXAlignment = Enum.TextXAlignment.Left
            PlayerButton.Parent = PlayerListFrame
            
            addCorner(PlayerButton, 8)
            
            -- Centered name label (vertically + clear of avatar)
            local NameLabel = Instance.new("TextLabel")
            NameLabel.Name = "NameLabel"
            NameLabel.Size = UDim2.new(1, -44, 1, 0)
            NameLabel.Position = UDim2.new(0, 40, 0, 0)
            NameLabel.BackgroundTransparency = 1
            NameLabel.Text = targetPlayer.Name
            NameLabel.TextColor3 = Color3.fromRGB(255, 255, 255)
            NameLabel.TextSize = 14
            NameLabel.Font = Enum.Font.GothamSemibold
            NameLabel.TextXAlignment = Enum.TextXAlignment.Left
            NameLabel.TextYAlignment = Enum.TextYAlignment.Center
            NameLabel.Parent = PlayerButton
            
            -- Tiny avatar headshot
            local Avatar = Instance.new("ImageLabel")
            Avatar.Name = "Avatar"
            Avatar.Size = UDim2.new(0, 28, 0, 28)
            Avatar.Position = UDim2.new(0, -1, 0.5, -14)
            Avatar.BackgroundColor3 = Color3.fromRGB(24, 26, 42)
            Avatar.BorderSizePixel = 0
            Avatar.Image = "rbxthumb://type=AvatarHeadShot&id=" .. targetPlayer.UserId .. "&w=48&h=48"
            Avatar.Parent = PlayerButton
            
            local AvatarCorner = Instance.new("UICorner")
            AvatarCorner.CornerRadius = UDim.new(1, 0) -- circle
            AvatarCorner.Parent = Avatar
            
            addStroke(Avatar, Color3.fromRGB(160, 80, 220), 1, 0.4)
            
            -- Highlight if selected
            if SelectedPlayer == targetPlayer then
                PlayerButton.BackgroundColor3 = Color3.fromRGB(150, 60, 220)
            end
            
            PlayerButton.MouseButton1Click:Connect(function()
                -- Select player
                SelectedPlayer = targetPlayer
                SelectedLabel.Text = "Selected: " .. targetPlayer.Name
                PlayerNameInput.Text = targetPlayer.Name
                SelectedAvatar.Image = "rbxthumb://type=AvatarHeadShot&id=" .. targetPlayer.UserId .. "&w=48&h=48"
                
                -- Turn off spectate if switching players
                if SpectateActive then
                    SpectateActive = false
                    ViewButton.BackgroundColor3 = Color3.fromRGB(32, 36, 55)
                    ViewButton.Text = "VIEW"
                    if OriginalCameraSubject then
                        workspace.CurrentCamera.CameraSubject = OriginalCameraSubject
                        OriginalCameraSubject = nil
                    else
                        workspace.CurrentCamera.CameraSubject = Player.Character.Humanoid
                    end
                end
                
                UpdatePlayerList() -- Refresh to update highlighting
            end)
        end
    end
    
    -- Update canvas size to fit all buttons
    PlayerListFrame.CanvasSize = UDim2.new(0, 0, 0, PlayerListLayout.AbsoluteContentSize.Y)
end

