-- LOAD VELOX (bundled via HttpGet — runs with this script)
local Velox
do
    local ok, result = pcall(function()
        return loadstring(game:HttpGet("https://raw.githubusercontent.com/DukeBigglesworth/Velox-UI/refs/heads/main/Creation"))()
    end)
    if ok and result then
        Velox = result
    else
        -- fallback: already in getgenv
        Velox = (getgenv and getgenv().Velox) or rawget(_G, "Velox")
    end
end

if not Velox then
    warn("[AETHER] Failed to load Velox UI library.")
    return
end
if getgenv then getgenv().Velox = Velox end

-- Make custom nametags fill the entire billboard (bg image covers full pill)
do
    local function FullCoverTag(billboard, tagConfig, player)
        if not billboard or not billboard:IsA("BillboardGui") then return end
        billboard.Size = UDim2.new(3.6, 0, 1.15, 0)
        billboard.StudsOffset = Vector3.new(0, (tagConfig and tagConfig.Height) or 2.2, 0)
        local pill = billboard:FindFirstChildOfClass("Frame")
        if not pill then return end
        pill.Size = UDim2.fromScale(1, 1)
        pill.Position = UDim2.fromScale(0, 0)
        pill.ClipsDescendants = true

        local bgImg = nil
        for _, child in ipairs(pill:GetChildren()) do
            if child:IsA("ImageLabel") then
                local isSmallIcon = child.Size.X.Scale < 0.3 and child.Size.X.Offset < 40
                if not isSmallIcon then
                    bgImg = child
                    break
                end
            end
        end
        if not bgImg then
            for _, child in ipairs(pill:GetChildren()) do
                if child:IsA("ImageLabel") and child.ScaleType == Enum.ScaleType.Crop then
                    bgImg = child
                    break
                end
            end
        end
        if bgImg then
            bgImg.Size = UDim2.fromScale(1, 1)
            bgImg.Position = UDim2.fromScale(0, 0)
            bgImg.AnchorPoint = Vector2.new(0, 0)
            bgImg.ScaleType = Enum.ScaleType.Stretch
            bgImg.ZIndex = 0
            bgImg.BackgroundTransparency = 1
            pill.BackgroundTransparency = 1
        end

        -- Collect text labels: top = title, bottom = username
        local labels = {}
        for _, child in ipairs(pill:GetChildren()) do
            if child:IsA("TextLabel") then
                table.insert(labels, child)
            end
        end
        table.sort(labels, function(a, b)
            return a.Position.Y.Scale < b.Position.Y.Scale
        end)

        local username = nil
        if player and player.Name then
            username = player.Name
        elseif billboard.Name:find("VeloxTag_") then
            local uid = tonumber(billboard.Name:match("VeloxTag_(%d+)"))
            if uid then
                local plr = Players:GetPlayerByUserId(uid)
                if plr then username = plr.Name end
            end
        end

        for i, lbl in ipairs(labels) do
            lbl.ZIndex = 2
            lbl.TextScaled = false
            lbl.TextWrapped = false
            lbl.TextTruncate = Enum.TextTruncate.AtEnd
            lbl.TextXAlignment = Enum.TextXAlignment.Center
            lbl.TextYAlignment = Enum.TextYAlignment.Center
            if i == 1 then
                -- Top title — centered
                lbl.TextSize = 13
                lbl.Size = UDim2.new(1, -8, 0.40, 0)
                lbl.Position = UDim2.new(0, 4, 0.10, 0)
            else
                -- Bottom line — username, centered
                lbl.TextSize = 11
                if username then
                    lbl.Text = username
                end
                lbl.Size = UDim2.new(1, -8, 0.32, 0)
                lbl.Position = UDim2.new(0, 4, 0.52, 0)
            end
        end

        for _, child in ipairs(pill:GetChildren()) do
            if child:IsA("ImageLabel") and child ~= bgImg then
                if child.ZIndex < 2 then child.ZIndex = 2 end
            end
        end
    end

    local function PatchExistingTags()
        local parents = {}
        pcall(function() table.insert(parents, game:GetService("CoreGui")) end)
        pcall(function() table.insert(parents, Player:FindFirstChild("PlayerGui")) end)
        for _, parent in ipairs(parents) do
            if parent then
                for _, g in ipairs(parent:GetChildren()) do
                    if type(g.Name) == "string" and g.Name:find("VeloxTag_") and g:IsA("BillboardGui") then
                        local uid = tonumber(g.Name:match("VeloxTag_(%d+)"))
                        local plr = uid and Players:GetPlayerByUserId(uid) or nil
                        FullCoverTag(g, nil, plr)
                    end
                end
            end
        end
    end

    if Velox.ApplyNametagToPlayer then
        local oldApply = Velox.ApplyNametagToPlayer
        function Velox:ApplyNametagToPlayer(player, tagConfig)
            -- Force subtitle to username before Velox builds the tag
            if tagConfig and player then
                tagConfig.Subtitle = player.Name
            end
            oldApply(self, player, tagConfig)
            task.defer(function()
                local uid = player and player.UserId
                if not uid then return end
                local parents = {}
                pcall(function() table.insert(parents, game:GetService("CoreGui")) end)
                pcall(function() table.insert(parents, Player:FindFirstChild("PlayerGui")) end)
                for _, parent in ipairs(parents) do
                    if parent then
                        local tag = parent:FindFirstChild("VeloxTag_" .. uid)
                        if tag then FullCoverTag(tag, tagConfig, player) end
                    end
                end
            end)
        end
    end

    -- Re-apply full cover when studio / role updates tags
    task.spawn(function()
        while task.wait(1) do
            if not ScriptActive then break end
            pcall(PatchExistingTags)
        end
    end)
end

local theme = (Velox.Themes and (Velox.Themes.TokyoPurple or Velox.Themes.Obsidian)) or nil

local Window
local okWin, winOrErr = pcall(function()
    return Velox:CreateWindow({
        Title       = "AETHER",
        SubTitle    = "Classic • Nametags",
        Theme       = theme,
        Preset      = "Classic",
        Size        = UDim2.fromOffset(500, 440),
        Keybind     = Enum.KeyCode.RightControl,
        Nametags    = true,
    })
end)

if okWin and winOrErr then
    Window = winOrErr
else
    warn("[AETHER] CreateWindow failed:", winOrErr)
    local ok2, win2 = pcall(function()
        return Velox:CreateWindow({
            Title = "AETHER",
            Theme = theme,
            Size  = UDim2.fromOffset(500, 440),
            Keybind = Enum.KeyCode.RightControl,
            Nametags = true,
        })
    end)
    if ok2 and win2 then
        Window = win2
    else
        warn("[AETHER] CreateWindow failed completely:", win2)
        return
    end
end

-- Nametag only for YOU (people without the script should not get fake tags)
pcall(function()
    Velox.NametagsEnabled = true

    local function TagLocal()
        local cfg = {
            Player    = Player,
            Role      = "Premium",
            Title     = "AETHER",
            Subtitle  = Player.Name,
            Color     = Color3.fromRGB(185, 110, 255),
            Icon      = (Velox.Icons and Velox.Icons.Crown) or "",
            Animation = "Neon Glow",
            Height    = 2.2,
        }
        if Velox.SetPlayerRole then
            Velox:SetPlayerRole(Player, "Premium")
        end
        if Velox.CreateNametag then
            Velox:CreateNametag(cfg)
        elseif Velox.ApplyNametagToPlayer then
            Velox:ApplyNametagToPlayer(Player, cfg)
        end
    end

    TagLocal()

    -- Re-apply only on your own respawn
    Player.CharacterAdded:Connect(function()
        task.wait(0.5)
        if ScriptActive then TagLocal() end
    end)

    -- Remove any tags that were put on other players by older versions
    local function StripOtherTags()
        local parents = {}
        pcall(function() table.insert(parents, game:GetService("CoreGui")) end)
        pcall(function() table.insert(parents, Player:FindFirstChild("PlayerGui")) end)
        for _, parent in ipairs(parents) do
            if parent then
                for _, g in ipairs(parent:GetChildren()) do
                    if type(g.Name) == "string" and g.Name:find("VeloxTag_") and g:IsA("BillboardGui") then
                        local uid = tonumber(g.Name:match("VeloxTag_(%d+)"))
                        if uid and uid ~= Player.UserId then
                            pcall(function() g:Destroy() end)
                        end
                    end
                end
            end
        end
    end
    StripOtherTags()
    task.spawn(function()
        while ScriptActive do
            StripOtherTags()
            task.wait(2)
        end
    end)
end)

local function safeNotify(title, content, nType, duration)
    pcall(function()
        Velox:Notify({
            Title = title or "AETHER",
            Content = content or "",
            Type = nType or "Info",
            Duration = duration or 3,
        })
    end)
end

