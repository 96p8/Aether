local AirWalkHeightStatus = MovementTab:CreateStatus({
    Name = "Baseplate Y",
    Default = "0",
})

local function ApplyBaseplatePosition()
    if AirWalkPart and RootPart then
        -- Center under the player so the surface always extends around you
        AirWalkPart.Position = Vector3.new(RootPart.Position.X, AirWalkY, RootPart.Position.Z)
    elseif AirWalkPart then
        AirWalkPart.Position = Vector3.new(0, AirWalkY, 0)
    end
    if AirWalkHeightStatus and AirWalkHeightStatus.Set then
        AirWalkHeightStatus.Set(string.format("%.1f", AirWalkY))
    end
end

local function StartHoldBaseplate(dir)
    AirWalkHolding = dir
    if not AirWalk then
        EnableAirWalk()
    end
end

local function StopHoldBaseplate()
    AirWalkHolding = 0
end

-- Hold-to-move: continuous adjust while mouse/touch is held on the button
local function BindHoldButton(btn, dir)
    if not btn then return end
    -- Velox CreateButton returns the card TextButton (or a table with Frame)
    local gui = btn
    if typeof(btn) == "table" then
        gui = btn.Frame or btn.Button or btn.Gui or btn
    end
    if typeof(gui) ~= "Instance" then return end

    local function begin(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1
            or input.UserInputType == Enum.UserInputType.Touch then
            StartHoldBaseplate(dir)
        end
    end
    local function finish(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1
            or input.UserInputType == Enum.UserInputType.Touch then
            StopHoldBaseplate()
        end
    end

    if gui:IsA("GuiButton") or gui:IsA("TextButton") or gui:IsA("ImageButton") then
        gui.MouseButton1Down:Connect(function() StartHoldBaseplate(dir) end)
        gui.MouseButton1Up:Connect(function() StopHoldBaseplate() end)
        gui.MouseLeave:Connect(function() StopHoldBaseplate() end)
    end
    gui.InputBegan:Connect(begin)
    gui.InputEnded:Connect(finish)
end

local upBtn = MovementTab:CreateButton({
    Name = "Baseplate Up ▲  (hold)",
    Description = "Hold to raise the air-walk baseplate",
    Callback = function() end, -- movement is driven by hold, not click
})
BindHoldButton(upBtn, 1)

local downBtn = MovementTab:CreateButton({
    Name = "Baseplate Down ▼  (hold)",
    Description = "Hold to lower the air-walk baseplate",
    Callback = function() end,
})
BindHoldButton(downBtn, -1)

-- Keep baseplate under the player (infinite feel) + hold height adjust
RunService.RenderStepped:Connect(function(dt)
    if AirWalkHolding ~= 0 then
        local delta = AirWalkHolding * AirWalkHoldSpeed * dt
        AirWalkY = AirWalkY + delta
        if not AirWalk then
            EnableAirWalk()
        end
        -- Keep character on the plate so they rise/lower with it
        if RootPart then
            local pos = RootPart.Position
            local standY = AirWalkY + 3.5
            RootPart.CFrame = CFrame.new(pos.X, standY, pos.Z) * (RootPart.CFrame - RootPart.CFrame.Position)
            RootPart.AssemblyLinearVelocity = Vector3.new(
                RootPart.AssemblyLinearVelocity.X,
                0,
                RootPart.AssemblyLinearVelocity.Z
            )
        end
    end
    -- Always track XZ under character while air walk is on
    if AirWalk and AirWalkPart then
        ApplyBaseplatePosition()
    end
end)

-- Global release safety (mouse up anywhere)
UserInputService.InputEnded:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1
        or input.UserInputType == Enum.UserInputType.Touch then
        StopHoldBaseplate()
    end
end)

