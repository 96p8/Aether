local AttachmentVelocity, AttachmentLoop, OriginalWalkSpeed
local AirWalkPart
local AirWalkY = 0  -- baseplate center Y (starts at 0)
local AirWalkHoldSpeed = 8  -- studs/sec while holding Up/Down
local AirWalkHolding = 0     -- 1 = up, -1 = down, 0 = none
local SavedPosition, RespawnTPEnabled = nil, false

