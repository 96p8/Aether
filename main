        DisableNoclip()
    else
        EnableNoclip()
    end
end)

TPToolButton.MouseButton1Click:Connect(function()
    TPToolActive = not TPToolActive
    if TPToolActive then
        TPToolButton.Text = "TP TOOL: ON"
        TPToolButton.BackgroundColor3 = Color3.fromRGB(150, 60, 220)
        
        -- Create TP tool
        TPToolInstance = Instance.new("Tool")
        TPToolInstance.Name = "TP Tool"
        TPToolInstance.RequiresHandle = false
        TPToolInstance.Parent = Player.Backpack
        
        -- Tool activated handler
        TPToolInstance.Activated:Connect(function()
            if RootPart and Mouse then
                local targetPos = Mouse.Hit.Position
                if AirWalk and AirWalkPart then
                    -- Stay at current air-walk height; move only XZ so you land on the platform instead of the void
                    local newPos = Vector3.new(targetPos.X, AirWalkTargetY, targetPos.Z)
                    RootPart.CFrame = CFrame.new(newPos)
                    AirWalkPart.Position = Vector3.new(newPos.X, AirWalkTargetY - 3.5, newPos.Z)
                else
                    RootPart.CFrame = CFrame.new(targetPos)
                end
            end
        end)
    else
        TPToolButton.Text = "TP TOOL: OFF"
        TPToolButton.BackgroundColor3 = Color3.fromRGB(32, 36, 55)
        
        -- Destroy TP tool
        if TPToolInstance then
            TPToolInstance:Destroy()
            TPToolInstance = nil
        end
    end
end)

