    end
    Humanoid.Sit = false
    Humanoid.PlatformStand = false
    if OriginalWalkSpeed then
        Humanoid.WalkSpeed = OriginalWalkSpeed
    end
    
    -- Clean up TP tool
    TPToolActive = false
    if TPToolInstance then
        TPToolInstance:Destroy()
        TPToolInstance = nil
    end
    
    -- Reset respawn TP
    RespawnTPEnabled = false
    SavedPosition = nil
    
    -- Reset other state
    SelectedPlayer = nil
    AttachmentMode = nil
    FlingActive = false
    
    -- Reset spectate
    SpectateActive = false
    if OriginalCameraSubject then
        workspace.CurrentCamera.CameraSubject = OriginalCameraSubject
    else
        workspace.CurrentCamera.CameraSubject = Player.Character.Humanoid
    end
    
    -- Reset button states
    ViewButton.BackgroundColor3 = Color3.fromRGB(32, 36, 55)
    ViewButton.Text = "VIEW"
    PlayerNameInput.Text = ""
    VCButton.Text = "VC BYPASS"
    VCButton.BackgroundColor3 = Color3.fromRGB(32, 36, 55)
    AntiAllButton.Text = "ANTI ALL"
    AntiAllButton.BackgroundColor3 = Color3.fromRGB(32, 36, 55)
    AntiAllPopup.Visible = false
    AntiAFKToggle.Text = "ANTI AFK: OFF"
    AntiAFKToggle.BackgroundColor3 = Color3.fromRGB(32, 36, 55)
    AntiSitToggle.Text = "ANTI SIT: OFF"
    AntiSitToggle.BackgroundColor3 = Color3.fromRGB(32, 36, 55)
    AntiVoidToggle.Text = "ANTI VOID: OFF"
    AntiVoidToggle.BackgroundColor3 = Color3.fromRGB(32, 36, 55)
    AntiGameplayToggle.Text = "ANTI PAUSED: OFF"
    AntiGameplayToggle.BackgroundColor3 = Color3.fromRGB(32, 36, 55)
    
    -- Reset anti all
    AntiAllEnabled = false
    AntiAFKEnabled = false
    AntiSitEnabled = false
    AntiVoidEnabled = false
    AntiGameplayPausedEnabled = false
    
    pcall(function() ScreenGui:Destroy() end)
    pcall(function() if script then script:Destroy() end end)
end)

