-- Fly logic
local BodyVelocity
local BodyGyro
local OriginalJumpPower
local OriginalJumpHeight
local OriginalAutoJumpEnabled

-- Attachment logic
local AttachmentVelocity
local AttachmentLoop
local OriginalWalkSpeed

-- Respawn teleport
local SavedPosition
local RespawnTPEnabled = false

-- Spectate
local SpectateActive = false
local OriginalCameraSubject

-- Anti All
local AntiAllEnabled = false
local AntiAFKEnabled = false
local AntiSitEnabled = false
local AntiVoidEnabled = false
local AntiGameplayPausedEnabled = false

-- Air Walk logic
local AirWalkPart
local AirWalkTargetY
local AirWalkBodyPosition

local function EnableFly()
    if not Flying then
        Flying = true
        FlyButton.Text = "FLY: ON"
        FlyButton.BackgroundColor3 = Color3.fromRGB(150, 60, 220)
        CurrentVelocity = Vector3.new() -- Reset velocity
        
        -- Store and disable jump
        OriginalJumpPower = Humanoid.JumpPower
        OriginalJumpHeight = Humanoid.UseJumpPower and Humanoid.JumpHeight or 0
        OriginalAutoJumpEnabled = Humanoid.AutoJumpEnabled
        Humanoid.JumpPower = 0
        Humanoid.JumpHeight = 0
        Humanoid.UseJumpPower = false
        Humanoid.AutoJumpEnabled = false
        
        BodyVelocity = Instance.new("BodyVelocity")
        BodyVelocity.Name = "FlyVelocity"
        BodyVelocity.MaxForce = Vector3.new(math.huge, math.huge, math.huge)
        BodyVelocity.Velocity = Vector3.new(0, 0, 0)
        BodyVelocity.Parent = RootPart
        
        BodyGyro = Instance.new("BodyGyro")
        BodyGyro.Name = "FlyGyro"
        BodyGyro.MaxTorque = Vector3.new(math.huge, math.huge, math.huge)
        BodyGyro.P = 10000
        BodyGyro.Parent = RootPart
        
        Humanoid.PlatformStand = true
    end
end

local function DisableFly()
    if Flying then
        Flying = false
        FlyButton.Text = "FLY: OFF"
        FlyButton.BackgroundColor3 = Color3.fromRGB(32, 36, 55)
        CurrentVelocity = Vector3.new() -- Reset velocity
        
        -- Restore jump settings
        if OriginalJumpPower then
            Humanoid.JumpPower = OriginalJumpPower
        end
        if OriginalJumpHeight then
            Humanoid.JumpHeight = OriginalJumpHeight
        end
        if OriginalAutoJumpEnabled ~= nil then
            Humanoid.AutoJumpEnabled = OriginalAutoJumpEnabled
        end
        Humanoid.UseJumpPower = true
        
        if BodyVelocity then
            BodyVelocity:Destroy()
            BodyVelocity = nil
        end
        
        if BodyGyro then
            BodyGyro:Destroy()
            BodyGyro = nil
        end
        
        Humanoid.PlatformStand = false
    end
end

-- Speed logic
local function EnableSpeed()
    if not SpeedBoost then
        SpeedBoost = true
        SpeedButton.Text = "SPEED: ON"
        SpeedButton.BackgroundColor3 = Color3.fromRGB(150, 60, 220)
        Humanoid.WalkSpeed = BoostSpeed
    end
end

local function DisableSpeed()
    if SpeedBoost then
        SpeedBoost = false
        SpeedButton.Text = "SPEED: OFF"
        SpeedButton.BackgroundColor3 = Color3.fromRGB(32, 36, 55)
        Humanoid.WalkSpeed = NormalSpeed
    end
end

-- Air Walk logic
local function EnableAirWalk()
    if not AirWalk then
        AirWalk = true
        AirWalkButton.Text = "AIR WALK: ON"
        AirWalkButton.BackgroundColor3 = Color3.fromRGB(150, 60, 220)
        
        -- Capture current Y position to lock height
        AirWalkTargetY = RootPart.Position.Y
        
        AirWalkPart = Instance.new("Part")
        AirWalkPart.Name = "AirWalkPlatform"
        AirWalkPart.Size = Vector3.new(512, 1, 512) -- large transparent baseplate
        AirWalkPart.Transparency = 1
        AirWalkPart.Anchored = true
        AirWalkPart.CanCollide = true
        AirWalkPart.CanQuery = false
        AirWalkPart.Material = Enum.Material.SmoothPlastic
        AirWalkPart.Parent = Workspace
    end
end

local function DisableAirWalk()
    if AirWalk then
        AirWalk = false
        AirWalkButton.Text = "AIR WALK: OFF"
        AirWalkButton.BackgroundColor3 = Color3.fromRGB(32, 36, 55)
        
        if AirWalkPart then
            AirWalkPart:Destroy()
            AirWalkPart = nil
        end
    end
end

local function EnableNoclip()
    if not Noclip then
        Noclip = true
        NoclipButton.Text = "NOCLIP: ON"
        NoclipButton.BackgroundColor3 = Color3.fromRGB(150, 60, 220)
    end
end

local function DisableNoclip()
    if Noclip then
        Noclip = false
        NoclipButton.Text = "NOCLIP: OFF"
        NoclipButton.BackgroundColor3 = Color3.fromRGB(32, 36, 55)
        if Character then
            for _, part in pairs(Character:GetDescendants()) do
                if part:IsA("BasePart") then
                    part.CanCollide = true
                end
            end
        end
    end
end

