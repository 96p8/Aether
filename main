            if not parent then return end
            for _, g in ipairs(parent:GetChildren()) do
                local n = g.Name
                if type(n) == "string" and (n:find("Velox") or n:find("Aether") or n:find("VeloxTag_")) then
                    pcall(function() g:Destroy() end)
                end
            end
        end
        wipe(Player:FindFirstChild("PlayerGui"))
        pcall(function() wipe(game:GetService("CoreGui")) end)
    end,
})



function runnerReanimate()
    if reanimToggleLock then return false, "busy" end
    reanimToggleLock = true
    local lastErr = nil
    local ok, err = pcall(function()
        local ch = Player.Character
        if not ch then
            ch = Player.CharacterAdded:Wait()
            task.wait(0.4)
        end
        local hum = ch and ch:FindFirstChildOfClass("Humanoid")
        local root = ch and ch:FindFirstChild("HumanoidRootPart")
        if root then
            root.Anchored = false
            root.AssemblyLinearVelocity = Vector3.new(0, 0, 0)
            root.AssemblyAngularVelocity = Vector3.new(0, 0, 0)
        end
        if hum then
            hum.PlatformStand = false
            hum.Sit = false
            hum.AutoRotate = true
            pcall(function() hum:ChangeState(Enum.HumanoidStateType.GettingUp) end)
        end
        task.wait(0.12)
        local runnerSrc = game:HttpGet(
            "https://raw.githubusercontent.com/projectZ678/tvm-reanim/refs/heads/master/runner.lua")
        assert(type(runnerSrc) == "string" and #runnerSrc > 50, "runner HttpGet failed")
        local runnerFn = loadstring(runnerSrc)
        assert(runnerFn, "runner loadstring failed")
        runnerFn()
        task.wait(0.35)
        Reanimated = true
        print("[AETHER] Runner reanimate ON")
    end)
    if not ok then
        lastErr = tostring(err)
        warn("[AETHER] runnerReanimate error:", lastErr)
        Reanimated = false
    end
    task.delay(0.55, function() reanimToggleLock = false end)
    return ok, lastErr
end


-- FEATURES (Infinite Yield style: do + localess function)
do
function EnableFly()
    if Flying or not RootPart or not Humanoid then return end
    Flying = true
    CurrentVelocity = Vector3.new(0, 0, 0)
    OriginalJumpPower = Humanoid.JumpPower
    OriginalJumpHeight = Humanoid.JumpHeight
    OriginalAutoJumpEnabled = Humanoid.AutoJumpEnabled
    Humanoid.JumpPower = 0
    Humanoid.JumpHeight = 0
    pcall(function() Humanoid.UseJumpPower = false end)
    Humanoid.AutoJumpEnabled = false
    BodyVelocity = Instance.new("BodyVelocity")
    BodyVelocity.Name = "FlyVelocity"
    BodyVelocity.MaxForce = Vector3.new(math.huge, math.huge, math.huge)
    BodyVelocity.Velocity = Vector3.new(0, 0, 0)
    BodyVelocity.Parent = RootPart
    BodyGyro = Instance.new("BodyGyro")
    BodyGyro.Name = "FlyGyro"
    BodyGyro.MaxTorque = Vector3.new(math.huge, math.huge, math.huge)
    BodyGyro.P = 10000
    BodyGyro.Parent = RootPart
    Humanoid.PlatformStand = true
end

function DisableFly()
    if not Flying then return end
    Flying = false
    CurrentVelocity = Vector3.new(0, 0, 0)
    if Humanoid then
        if OriginalJumpPower then Humanoid.JumpPower = OriginalJumpPower end
        if OriginalJumpHeight then Humanoid.JumpHeight = OriginalJumpHeight end
        if OriginalAutoJumpEnabled ~= nil then Humanoid.AutoJumpEnabled = OriginalAutoJumpEnabled end
        pcall(function() Humanoid.UseJumpPower = true end)
        Humanoid.PlatformStand = false
    end
    if BodyVelocity then BodyVelocity:Destroy() BodyVelocity = nil end
    if BodyGyro then BodyGyro:Destroy() BodyGyro = nil end
end

function EnableSpeed()
    if SpeedBoost or not Humanoid then return end
    SpeedBoost = true
    Humanoid.WalkSpeed = BoostSpeed
end

function DisableSpeed()
    if not SpeedBoost then return end
    SpeedBoost = false
    if Humanoid then Humanoid.WalkSpeed = NormalSpeed end
end

function EnableAirWalk()
    if AirWalk and AirWalkPart then
        ApplyBaseplatePosition()
        return
    end
    AirWalk = true
    if AirWalkPart then AirWalkPart:Destroy() end
    AirWalkPart = Instance.new("Part")
    AirWalkPart.Name = "AirWalkBaseplate"
    AirWalkPart.Size = Vector3.new(10000, 1, 10000)
    local cx = RootPart and RootPart.Position.X or 0
    local cz = RootPart and RootPart.Position.Z or 0
    AirWalkPart.Position = Vector3.new(cx, AirWalkY, cz)
    AirWalkPart.Anchored = true
    AirWalkPart.CanCollide = true
    AirWalkPart.CanQuery = false
    AirWalkPart.Transparency = 1
    AirWalkPart.Material = Enum.Material.SmoothPlastic
    AirWalkPart.Parent = Workspace
    if AirWalkHeightStatus and AirWalkHeightStatus.Set then
        AirWalkHeightStatus.Set(string.format("%.1f", AirWalkY))
    end
end

function DisableAirWalk()
    if not AirWalk then return end
    AirWalk = false
    if AirWalkPart then AirWalkPart:Destroy() AirWalkPart = nil end
end

function ToggleTPTool(state)
    TPToolActive = state
    if state then
        if TPToolInstance then TPToolInstance:Destroy() end
        TPToolInstance = Instance.new("Tool")
        TPToolInstance.Name = "TP Tool"
        TPToolInstance.RequiresHandle = false
        TPToolInstance.Parent = Player:FindFirstChild("Backpack") or Player:WaitForChild("Backpack")
        TPToolInstance.Activated:Connect(function()
            if not RootPart or not Mouse then return end
            local targetPos = Mouse.Hit.Position
            local y = AirWalk and (AirWalkY + 3) or (targetPos.Y + 3)
            local newPos = Vector3.new(targetPos.X, y, targetPos.Z)
            local look = RootPart.CFrame.LookVector
            local flat = Vector3.new(look.X, 0, look.Z)
            if flat.Magnitude < 0.05 then
                flat = Vector3.new(0, 0, -1)
            else
                flat = flat.Unit
            end
            RootPart.AssemblyLinearVelocity = Vector3.new(0, 0, 0)
            RootPart.AssemblyAngularVelocity = Vector3.new(0, 0, 0)
            RootPart.CFrame = CFrame.new(newPos, newPos + flat)
        end)
    else
        if TPToolInstance then TPToolInstance:Destroy() TPToolInstance = nil end
    end
end

function runAVCB()
    if not getconnections then
        return false, "getconnections not available"
    end

    local clonereference = cloneref or function(...) return ... end
    local clonefunction = clonefunction or function(...) return ... end

    local VoiceChatService, VoiceChatInternal
    pcall(function()
        VoiceChatService = clonereference(game:GetService("VoiceChatService"))
    end)
    pcall(function()
        VoiceChatInternal = clonereference(game:GetService("VoiceChatInternal"))
    end)
    if not VoiceChatService or not VoiceChatInternal then
        return false, "VoiceChat services unavailable"
    end

    local getconnectionsfunc = nil
    pcall(function()
        getconnectionsfunc = clonefunction(getconnections)
    end)
    if not getconnectionsfunc then
        return false, "getconnections clone failed"
    end

    pcall(function()
        VoiceChatService:rejoinVoice()
    end)
    task.wait(0.02)

    pcall(function()
        for _, connection in pairs(getconnections(VoiceChatInternal.StateChanged)) do
            pcall(function() connection:Disable() end)
        end
    end)
    task.wait(1)

    pcall(function()
        local connections = getconnectionsfunc(VoiceChatInternal.StateChanged)
        for i = 7, #connections do
            if connections[i] then
                pcall(function() connections[i]:Disable() end)
            end
        end
    end)
    task.wait(2)

    local joinDone, joinOk = false, false
    local joinWait = tick()
    task.spawn(function()
        joinOk = pcall(function()
            VoiceChatService:joinVoice()
        end)
        joinDone = true
    end)
    while not joinDone and tick() - joinWait < 8 do
        task.wait(0.1)
    end
    task.wait(2)

    if not joinOk then
        return false, "joinVoice failed"
    end
    return true, "ok"
end

function UpdateFly(dt)
    if not (Flying and BodyVelocity and BodyGyro and Camera and RootPart and Humanoid) then return end
    if Humanoid:GetState() ~= Enum.HumanoidStateType.Freefall then
        pcall(function() Humanoid:ChangeState(Enum.HumanoidStateType.Freefall) end)
    end
    local move = Vector3.new(0, 0, 0)
    local targetSpeed = FlySpeed
    if UserInputService:IsKeyDown(Enum.KeyCode.LeftShift) then
        targetSpeed = FlySpeed * FlySprintMultiplier
    end
    local camCF = Camera.CFrame
    if UserInputService:IsKeyDown(Enum.KeyCode.W) then move = move + camCF.LookVector end
    if UserInputService:IsKeyDown(Enum.KeyCode.S) then move = move - camCF.LookVector end
    if UserInputService:IsKeyDown(Enum.KeyCode.A) then move = move - camCF.RightVector end
    if UserInputService:IsKeyDown(Enum.KeyCode.D) then move = move + camCF.RightVector end
    if move.Magnitude > 0 then move = move.Unit * targetSpeed end
    local lerp = math.clamp(FlyAcceleration * dt, 0, 1)
    CurrentVelocity = CurrentVelocity:Lerp(move, lerp)
    BodyVelocity.Velocity = CurrentVelocity
    BodyGyro.CFrame = camCF
end
end -- features do

RunService.RenderStepped:Connect(function(dt)
    if not ScriptActive then return end
    UpdateFly(dt)
end)

RunService.Heartbeat:Connect(function()
    if AntiAFKEnabled then
        pcall(function()
            VirtualInput:SendKeyEvent(false, Enum.KeyCode.W, false, game)
            task.wait()
            VirtualInput:SendKeyEvent(true, Enum.KeyCode.W, false, game)
        end)
    end
end)

RunService.RenderStepped:Connect(function()
    if AntiVoidEnabled and RootPart and RootPart.Position.Y < -100 then
        RootPart.CFrame = CFrame.new(RootPart.Position.X, 10, RootPart.Position.Z)
        RootPart.AssemblyLinearVelocity = Vector3.new(0, 100, 0)
    end
end)

do
function simulateActivity()
    pcall(function()
        VirtualInput:SendKeyEvent(true, Enum.KeyCode.W, false, game)
        task.wait()
        VirtualInput:SendKeyEvent(false, Enum.KeyCode.W, false, game)
    end)
end
end

-- Anti Gameplay Paused is handled via NetworkPause destroy (see Settings toggle)

do
function HookAntiSit(hum)
    if not hum then return end
    hum.Seated:Connect(function()
        if AntiSitEnabled then
            hum.PlatformStand = true
            task.wait(0.1)
            hum.PlatformStand = false
            pcall(function() hum:ChangeState(Enum.HumanoidStateType.Jumping) end)
        end
    end)
end
end
HookAntiSit(Humanoid)

Player.CharacterAdded:Connect(function(newChar)
    RefreshCharacter(newChar)
    NormalSpeed = Humanoid.WalkSpeed
    HookAntiSit(Humanoid)
    Humanoid.Died:Connect(function()
        if RespawnTPEnabled and RootPart then SavedPosition = RootPart.CFrame end
    end)
    if RespawnTPEnabled and SavedPosition then
        task.wait(0.5)
        if RootPart then RootPart.CFrame = SavedPosition end
    end
    if Flying then DisableFly() end
    if SpeedBoost then DisableSpeed() end
    if AirWalk then DisableAirWalk() end
    if TPToolActive then ToggleTPTool(false) end
    StopAttachment()
    FlingActive = false
    if Reanimated then
        Reanimated = false
        safeNotify("Reanim", "Character respawned — reanim reset", "Warning", 3)
    end
    if SpectateActive then
        SpectateActive = false
        if Humanoid then Camera.CameraSubject = Humanoid end
    end
end)


-- Velocity clamp while reanimated
task.spawn(function()
    while ScriptActive do
        RunService.Heartbeat:Wait()
        if Reanimated then
            local ch = Player.Character
            if ch then
                local root = ch:FindFirstChild("HumanoidRootPart")
                if root and not root.Anchored then
                    local v = root.AssemblyLinearVelocity
                    if v.Magnitude > 250 then
                        root.AssemblyLinearVelocity = v.Unit * 250
                    end
                    local av = root.AssemblyAngularVelocity
                    if av.Magnitude > 60 then
                        root.AssemblyAngularVelocity = av.Unit * 60
                    end
                end
            end
        end
    end
end)


if Humanoid then
    Humanoid.Died:Connect(function()
        if RespawnTPEnabled and RootPart then SavedPosition = RootPart.CFrame end
    end)
end

Players.PlayerRemoving:Connect(function(p)
    if SelectedPlayer == p then
        SelectedPlayer = nil
        if SelectedStatus and SelectedStatus.Set then SelectedStatus.Set("None") end
        StopAttachment()
        FlingActive = false
        if SpectateActive then
            SpectateActive = false
            if Humanoid then Camera.CameraSubject = Humanoid end
        end
    end
end)

