local function colorToTable(c)
    return { r = math.floor(c.R * 255 + 0.5), g = math.floor(c.G * 255 + 0.5), b = math.floor(c.B * 255 + 0.5) }
end
local function tableToColor(t)
    if type(t) ~= "table" then return Color3.fromRGB(165, 85, 255) end
    return Color3.fromRGB(tonumber(t.r) or 165, tonumber(t.g) or 85, tonumber(t.b) or 255)
end

