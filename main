-- Make Anti All popup movable via title bar
do
    local popupDragging = false
    local popupDragStart = Vector2.new()
    local popupStartPos = UDim2.new()

    AntiAllTitle.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1
            or input.UserInputType == Enum.UserInputType.Touch then
            popupDragging = true
            popupDragStart = Vector2.new(input.Position.X, input.Position.Y)
            popupStartPos = AntiAllPopup.Position
        end
    end)

    UserInputService.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1
            or input.UserInputType == Enum.UserInputType.Touch then
            popupDragging = false
        end
    end)

    UserInputService.InputChanged:Connect(function(input)
        if not popupDragging then return end
        if input.UserInputType ~= Enum.UserInputType.MouseMovement
            and input.UserInputType ~= Enum.UserInputType.Touch then return end
        local delta = Vector2.new(input.Position.X, input.Position.Y) - popupDragStart
        AntiAllPopup.Position = UDim2.new(
            popupStartPos.X.Scale, popupStartPos.X.Offset + delta.X,
            popupStartPos.Y.Scale, popupStartPos.Y.Offset + delta.Y
        )
    end)
end

